@using PatientCrm.Web.Services
@{
    ViewData["Title"] = "Dashboard";
    var recentPatients = ViewBag.RecentPatients as List<PatientSummary> ?? new();
    var upcomingAppts = ViewBag.UpcomingAppointments as List<AppointmentSummary> ?? new();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back, @User.Identity?.Name — here's your clinical overview.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Patients/Create" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Register Patient
        </a>
    </div>
</div>

<!-- Stats Grid -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
            </svg>
        </div>
        <div>
            <div class="stat-value">@ViewBag.TotalPatients</div>
            <div class="stat-label">Total Patients</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon green">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
        </div>
        <div>
            <div class="stat-value">@ViewBag.TodayAppointments</div>
            <div class="stat-label">Today's Appointments</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon amber">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="14.31" y1="8" x2="20.05" y2="17.94"/>
                <line x1="9.69" y1="8" x2="21.17" y2="8"/><line x1="7.38" y1="12" x2="13.12" y2="2.06"/>
            </svg>
        </div>
        <div>
            <div class="stat-value">@ViewBag.ActivePrescriptions</div>
            <div class="stat-label">Active Prescriptions</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon red">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </div>
        <div>
            <div class="stat-value">@ViewBag.ActiveAlerts</div>
            <div class="stat-label">Active Alerts</div>
        </div>
    </div>
</div>

<div class="d-flex gap-4" style="flex-wrap: wrap; align-items: flex-start;">
    <!-- Recent Patients -->
    <div class="table-container" style="flex: 1; min-width: 320px;">
        <div class="table-header">
            <h3 class="card-title">Recently Registered</h3>
            <a href="/Patients" class="btn btn-sm btn-secondary">View All</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>NHS / HSCNI No.</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in recentPatients)
                {
                    <tr>
                        <td>
                            <div class="patient-info">
                                <div class="patient-avatar">@(patient.FirstName?.Substring(0,1) ?? "?")@(patient.LastName?.Substring(0,1) ?? "?")</div>
                                <div>
                                    <div class="patient-name">@patient.FullName</div>
                                    <div class="patient-meta">DOB: @patient.DateOfBirth.ToString("dd MMM yyyy")</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(patient.NhsNumber))
                            {
                                <span class="nhs-badge">NHS @patient.NhsNumber</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge badge-green">Active</span>
                        </td>
                    </tr>
                }
                @if (!recentPatients.Any())
                {
                    <tr><td colspan="3" style="text-align: center; color: var(--text-muted); padding: 2rem;">No patients yet</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Upcoming Appointments -->
    <div class="table-container" style="flex: 1; min-width: 320px;">
        <div class="table-header">
            <h3 class="card-title">Upcoming Appointments</h3>
            <a href="/Appointments" class="btn btn-sm btn-secondary">View All</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Time</th>
                    <th>Type</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in upcomingAppts)
                {
                    <tr>
                        <td>
                            <div class="patient-name">@appt.PatientName</div>
                            <div class="patient-meta">@appt.Title</div>
                        </td>
                        <td>
                            <div class="fw-600">@appt.StartTime.ToString("HH:mm")</div>
                            <div class="patient-meta">@appt.StartTime.ToString("dd MMM")</div>
                        </td>
                        <td>
                            <span class="badge badge-blue">Appointment</span>
                        </td>
                    </tr>
                }
                @if (!upcomingAppts.Any())
                {
                    <tr><td colspan="3" style="text-align: center; color: var(--text-muted); padding: 2rem;">No upcoming appointments</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
