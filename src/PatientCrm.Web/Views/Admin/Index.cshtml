@{
    ViewData["Title"] = "Administration";
    var tenants = ViewBag.Tenants as List<PatientCrm.Core.Entities.Tenant> ?? new();
    bool isSuperAdmin = ViewBag.IsSuperAdmin == true;
}

<div class="page-header">
    <div>
        <h1 class="page-title">@(isSuperAdmin ? "Super Admin" : "Admin") Dashboard</h1>
        <p class="page-subtitle">@(isSuperAdmin ? "Global system administration" : "Manage your organisation")</p>
    </div>
    @if (isSuperAdmin)
    {
        <a href="/Admin/Clients/Create" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Client
        </a>
    }
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon blue">🏥</div>
        <div><div class="stat-value">@ViewBag.TenantCount</div><div class="stat-label">Active Clients</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">👤</div>
        <div><div class="stat-value">@ViewBag.UserCount</div><div class="stat-label">Active Users</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple">🧑‍⚕️</div>
        <div><div class="stat-value">@ViewBag.PatientCount</div><div class="stat-label">Total Patients</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon teal">🩺</div>
        <div><div class="stat-value">@ViewBag.GpCount</div><div class="stat-label">GP Practices</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon amber">🦷</div>
        <div><div class="stat-value">@ViewBag.DentalCount</div><div class="stat-label">Dental Practices</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon red">🏨</div>
        <div><div class="stat-value">@ViewBag.HospitalCount</div><div class="stat-label">Hospitals / Consultants</div></div>
    </div>
</div>

<div class="d-flex gap-2" style="margin-bottom: 1.5rem; flex-wrap: wrap;">
    <a href="/Admin/Clients" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
        Manage Clients
    </a>
    <a href="/Admin/Users" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        Manage Users
    </a>
</div>

<div class="table-container">
    <div class="table-header">
        <h3 class="card-title">@(isSuperAdmin ? "All Clients" : "Your Organisation")</h3>
        <a href="/Admin/Clients" class="btn btn-sm btn-secondary">View Full List</a>
    </div>
    <table>
        <thead>
            <tr><th>Organisation</th><th>Client Type</th><th>NHS/HSCNI Type</th><th>ODS Code</th><th>Location</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var tenant in tenants)
            {
                <tr>
                    <td>
                        <div class="fw-600">@tenant.Name</div>
                        <div class="patient-meta">@tenant.Email</div>
                    </td>
                    <td>
                        @{
                            var ctBadge = tenant.ClientType switch {
                                PatientCrm.Core.Enums.ClientType.GpPractice => ("badge-teal", "🩺 GP Practice"),
                                PatientCrm.Core.Enums.ClientType.DentalPractice => ("badge-amber", "🦷 Dental"),
                                PatientCrm.Core.Enums.ClientType.HospitalConsulting => ("badge-red", "🏨 Hospital"),
                                PatientCrm.Core.Enums.ClientType.HealthCentre => ("badge-blue", "🏥 Health Centre"),
                                PatientCrm.Core.Enums.ClientType.WalkInCentre => ("badge-purple", "🚶 Walk-In"),
                                PatientCrm.Core.Enums.ClientType.MentalHealthService => ("badge-purple", "🧠 Mental Health"),
                                _ => ("badge-gray", tenant.ClientType.ToString())
                            };
                        }
                        <span class="badge @ctBadge.Item1">@ctBadge.Item2</span>
                    </td>
                    <td>
                        <span class="badge @(tenant.TenantType == PatientCrm.Core.Enums.TenantType.Hscni ? "badge-purple" : tenant.TenantType == PatientCrm.Core.Enums.TenantType.PrivatePractice ? "badge-amber" : "badge-blue")">
                            @tenant.TenantType
                        </span>
                    </td>
                    <td>@(tenant.OdsCode ?? "—")</td>
                    <td>@tenant.City, @tenant.Postcode</td>
                    <td>
                        <span class="badge @(tenant.IsActive ? "badge-green" : "badge-gray")">@(tenant.IsActive ? "Active" : "Inactive")</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
