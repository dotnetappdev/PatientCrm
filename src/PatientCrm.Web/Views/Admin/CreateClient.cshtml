@model PatientCrm.Core.Entities.Tenant
@{
    ViewData["Title"] = "Add Client";
}

<div class="page-header">
    <div>
        <a href="/Admin/Clients" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem;">← Clients</a>
        <h1 class="page-title" style="margin-top: 0.25rem;">Add New Client</h1>
        <p class="page-subtitle">Register a new GP practice, dental surgery, hospital, or other healthcare organisation</p>
    </div>
</div>

<form method="post" asp-action="CreateClient">
    @Html.AntiForgeryToken()

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.25rem;">

        <!-- Organisation Details -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Organisation Details</h3></div>

            <div class="form-group">
                <label class="form-label">Organisation Name *</label>
                <input asp-for="Name" class="form-control" required placeholder="e.g. Greenfield Medical Practice" />
                <span asp-validation-for="Name" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">URL Slug</label>
                <input asp-for="Slug" class="form-control" placeholder="auto-generated from name" />
                <span class="patient-meta" style="font-size: 0.7rem;">Leave blank to auto-generate from name.</span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Client Type *</label>
                    <select asp-for="ClientType" class="form-control" required>
                        @foreach (var ct in (PatientCrm.Core.Enums.ClientType[])ViewBag.ClientTypes)
                        {
                            <option value="@ct">@ct</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">NHS / HSCNI Type</label>
                    <select asp-for="TenantType" class="form-control">
                        @foreach (var tt in (PatientCrm.Core.Enums.TenantType[])ViewBag.TenantTypes)
                        {
                            <option value="@tt">@tt</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">ODS Code</label>
                <input asp-for="OdsCode" class="form-control" placeholder="e.g. A81001" />
            </div>
        </div>

        <!-- Contact Information -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Contact Information</h3></div>

            <div class="form-group">
                <label class="form-label">Primary Contact Name</label>
                <input asp-for="ContactName" class="form-control" placeholder="e.g. Practice Manager" />
            </div>
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="info@practice.nhs.uk" />
            </div>
            <div class="form-group">
                <label class="form-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="01234 567890" />
            </div>
            <div class="form-group">
                <label class="form-label">Website</label>
                <input asp-for="Website" type="url" class="form-control" placeholder="https://www.practice.nhs.uk" />
            </div>
        </div>

        <!-- Address -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Address</h3></div>

            <div class="form-group">
                <label class="form-label">Street Address</label>
                <input asp-for="Address" class="form-control" placeholder="1 High Street" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">City / Town</label>
                    <input asp-for="City" class="form-control" placeholder="Manchester" />
                </div>
                <div class="form-group">
                    <label class="form-label">Postcode</label>
                    <input asp-for="Postcode" class="form-control" placeholder="M1 1AA" />
                </div>
            </div>
        </div>

        <!-- System Settings -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">System Settings</h3></div>

            <div class="form-group">
                <label class="form-label">Database Provider</label>
                <select asp-for="DatabaseProvider" class="form-control">
                    @foreach (var dp in (PatientCrm.Core.Enums.DatabaseProvider[])ViewBag.DbProviders)
                    {
                        <option value="@dp">@dp</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Notes / Internal Comments</label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Internal notes about this client…"></textarea>
            </div>
            <div class="form-group">
                <label class="form-check">
                    <input asp-for="IsActive" type="checkbox" />
                    <span style="font-size: 0.875rem;">Active (can log in immediately)</span>
                </label>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2" style="margin-top: 1.5rem; justify-content: flex-end;">
        <a href="/Admin/Clients" class="btn btn-secondary btn-lg">Cancel</a>
        <button type="submit" class="btn btn-primary btn-lg">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20,6 9,17 4,12"/></svg>
            Create Client
        </button>
    </div>
</form>
