@model List<PatientCrm.Core.Entities.Tenant>
@{
    ViewData["Title"] = "Clients";
    bool isSuperAdmin = ViewBag.IsSuperAdmin == true;
}

<div class="page-header">
    <div>
        <a href="/Admin" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem;">← Admin</a>
        <h1 class="page-title" style="margin-top: 0.25rem;">Clients</h1>
        <p class="page-subtitle">@Model.Count client @(Model.Count == 1 ? "organisation" : "organisations")</p>
    </div>
    @if (isSuperAdmin)
    {
        <a href="/Admin/Clients/Create" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Client
        </a>
    }
</div>

<div class="table-container">
    <div class="table-header">
        <form method="get" class="d-flex gap-2" style="flex: 1; flex-wrap: wrap;">
            <div style="position: relative; flex: 1; min-width: 220px; max-width: 360px;">
                <svg style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name, ODS code, city…" class="form-control" style="padding-left: 2.25rem;" />
            </div>
            <select name="clientType" class="form-control" style="max-width: 220px;">
                <option value="">All Client Types</option>
                @foreach (var ct in (PatientCrm.Core.Enums.ClientType[])ViewBag.ClientTypes)
                {
                    if (ViewBag.ClientTypeFilter?.ToString() == ct.ToString())
                    {
                        <option value="@ct" selected="selected">@ct</option>
                    }
                    else
                    {
                        <option value="@ct">@ct</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-secondary">Filter</button>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>Organisation</th>
                <th>Client Type</th>
                <th>NHS/HSCNI</th>
                <th>ODS Code</th>
                <th>Contact</th>
                <th>Location</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tenant in Model)
            {
                <tr>
                    <td>
                        <div class="fw-600">@tenant.Name</div>
                        @if (!string.IsNullOrEmpty(tenant.ContactName))
                        {
                            <div class="patient-meta">Contact: @tenant.ContactName</div>
                        }
                    </td>
                    <td>
                        @{
                            var (ctClass, ctLabel) = tenant.ClientType switch {
                                PatientCrm.Core.Enums.ClientType.GpPractice => ("badge-teal", "🩺 GP Practice"),
                                PatientCrm.Core.Enums.ClientType.DentalPractice => ("badge-amber", "🦷 Dental Practice"),
                                PatientCrm.Core.Enums.ClientType.HospitalConsulting => ("badge-red", "🏨 Hospital / Consultant"),
                                PatientCrm.Core.Enums.ClientType.HealthCentre => ("badge-blue", "🏥 Health Centre"),
                                PatientCrm.Core.Enums.ClientType.WalkInCentre => ("badge-purple", "🚶 Walk-In Centre"),
                                PatientCrm.Core.Enums.ClientType.MentalHealthService => ("badge-purple", "🧠 Mental Health"),
                                PatientCrm.Core.Enums.ClientType.PhysiotherapyPractice => ("badge-teal", "🏃 Physiotherapy"),
                                _ => ("badge-gray", tenant.ClientType.ToString())
                            };
                        }
                        <span class="badge @ctClass">@ctLabel</span>
                    </td>
                    <td>
                        <span class="badge @(tenant.TenantType == PatientCrm.Core.Enums.TenantType.Hscni ? "badge-purple" : tenant.TenantType == PatientCrm.Core.Enums.TenantType.PrivatePractice ? "badge-amber" : "badge-blue")">
                            @tenant.TenantType
                        </span>
                    </td>
                    <td>@(tenant.OdsCode ?? "—")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(tenant.PhoneNumber)) { <div>@tenant.PhoneNumber</div> }
                        @if (!string.IsNullOrEmpty(tenant.Email)) { <div class="patient-meta fs-sm">@tenant.Email</div> }
                    </td>
                    <td>@tenant.City, @tenant.Postcode</td>
                    <td>
                        <span class="badge @(tenant.IsActive ? "badge-green" : "badge-gray")">@(tenant.IsActive ? "Active" : "Inactive")</span>
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="/Admin/Clients/Edit/@tenant.Id" class="btn btn-sm btn-secondary">Edit</a>
                            @if (isSuperAdmin)
                            {
                                <form method="post" action="/Admin/Clients/Toggle/@tenant.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(tenant.IsActive ? "btn-danger" : "btn-success")"
                                        onclick="return confirm('@(tenant.IsActive ? "Deactivate" : "Activate") @tenant.Name?')">
                                        @(tenant.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                        No clients found.
                        @if (isSuperAdmin) { <a href="/Admin/Clients/Create">Add the first client</a> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
