@model PatientCrm.Core.Entities.Tenant
@{
    ViewData["Title"] = $"Edit — {Model.Name}";
}

<div class="page-header">
    <div>
        <a href="/Admin/Clients" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem;">← Clients</a>
        <h1 class="page-title" style="margin-top: 0.25rem;">Edit Client</h1>
        <p class="page-subtitle">@Model.Name</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge @(Model.IsActive ? "badge-green" : "badge-gray")">@(Model.IsActive ? "Active" : "Inactive")</span>
    </div>
</div>

<form method="post" action="/Admin/Clients/Edit/@Model.Id">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Slug" />
    <input type="hidden" asp-for="CreatedAt" />

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.25rem;">

        <!-- Organisation Details -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Organisation Details</h3></div>

            <div class="form-group">
                <label class="form-label">Organisation Name *</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Client Type</label>
                    <select asp-for="ClientType" class="form-control">
                        @foreach (var ct in (PatientCrm.Core.Enums.ClientType[])ViewBag.ClientTypes)
                        {
                            if (Model.ClientType == ct)
                            {
                                <option value="@ct" selected="selected">@ct</option>
                            }
                            else
                            {
                                <option value="@ct">@ct</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">NHS / HSCNI Type</label>
                    <select asp-for="TenantType" class="form-control">
                        @foreach (var tt in (PatientCrm.Core.Enums.TenantType[])ViewBag.TenantTypes)
                        {
                            if (Model.TenantType == tt)
                            {
                                <option value="@tt" selected="selected">@tt</option>
                            }
                            else
                            {
                                <option value="@tt">@tt</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">ODS Code</label>
                <input asp-for="OdsCode" class="form-control" />
            </div>
        </div>

        <!-- Contact -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Contact Information</h3></div>
            <div class="form-group">
                <label class="form-label">Primary Contact Name</label>
                <input asp-for="ContactName" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Website</label>
                <input asp-for="Website" type="url" class="form-control" />
            </div>
        </div>

        <!-- Address -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Address</h3></div>
            <div class="form-group">
                <label class="form-label">Street Address</label>
                <input asp-for="Address" class="form-control" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">City</label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Postcode</label>
                    <input asp-for="Postcode" class="form-control" />
                </div>
            </div>
        </div>

        <!-- Settings -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Settings</h3></div>
            <div class="form-group">
                <label class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
            <div class="form-group">
                <label class="form-check">
                    <input asp-for="IsActive" type="checkbox" />
                    <span style="font-size: 0.875rem;">Active</span>
                </label>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2" style="margin-top: 1.5rem; justify-content: flex-end;">
        <a href="/Admin/Clients" class="btn btn-secondary btn-lg">Cancel</a>
        <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
    </div>
</form>
