@model List<PatientCrm.Core.Entities.Tenant>
@{
    ViewData["Title"] = "Tenants";
}

<div class="page-header">
    <div>
        <a href="/Admin" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem;">← Admin</a>
        <h1 class="page-title" style="margin-top: 0.25rem;">Tenants / Organisations</h1>
    </div>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr><th>Organisation</th><th>Type</th><th>ODS Code</th><th>Location</th><th>Contact</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var tenant in Model)
            {
                <tr>
                    <td>
                        <div class="fw-600">@tenant.Name</div>
                        <div class="patient-meta">@tenant.Website</div>
                    </td>
                    <td>
                        <span class="badge @(tenant.TenantType == PatientCrm.Core.Enums.TenantType.Hscni ? "badge-purple" : tenant.TenantType == PatientCrm.Core.Enums.TenantType.PrivatePractice ? "badge-amber" : "badge-blue")">
                            @tenant.TenantType
                        </span>
                    </td>
                    <td>@(tenant.OdsCode ?? "—")</td>
                    <td>@tenant.City, @tenant.Postcode</td>
                    <td>
                        <div>@tenant.PhoneNumber</div>
                        <div class="patient-meta fs-sm">@tenant.Email</div>
                    </td>
                    <td><span class="badge @(tenant.IsActive ? "badge-green" : "badge-gray")">@(tenant.IsActive ? "Active" : "Inactive")</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
