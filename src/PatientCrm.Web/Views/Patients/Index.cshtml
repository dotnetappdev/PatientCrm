@model List<PatientCrm.Core.Entities.Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Patients</h1>
        <p class="page-subtitle">@ViewBag.Total patient records</p>
    </div>
    <a href="/Patients/Create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Register Patient
    </a>
</div>

<div class="table-container">
    <div class="table-header">
        <form method="get" class="d-flex gap-2" style="flex: 1;">
            <div style="position: relative; flex: 1; max-width: 400px;">
                <svg style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name, NHS/HSCNI number..." class="form-control" style="padding-left: 2.25rem;" />
            </div>
            <button type="submit" class="btn btn-secondary">Search</button>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>Patient</th>
                <th>NHS / HSCNI No.</th>
                <th>Date of Birth</th>
                <th>Contact</th>
                <th>Region</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>
                        <div class="patient-info">
                            <div class="patient-avatar">@(patient.FirstName.Substring(0,1))@(patient.LastName.Substring(0,1))</div>
                            <div>
                                <div class="patient-name">
                                    <a href="/Patients/Details/@patient.Id" style="text-decoration: none; color: var(--text-primary);">@patient.FullName</a>
                                </div>
                                <div class="patient-meta">@patient.Gender | @patient.BloodGroup</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(patient.NhsNumber))
                        {
                            <span class="nhs-badge">NHS @patient.NhsNumber</span>
                        }
                        else if (!string.IsNullOrEmpty(patient.HscniNumber))
                        {
                            <span class="hscni-badge">@patient.HscniNumber</span>
                        }
                        else
                        {
                            <span class="text-muted">Not registered</span>
                        }
                    </td>
                    <td>
                        <div>@patient.DateOfBirth.ToString("dd MMM yyyy")</div>
                        <div class="patient-meta">Age: @(DateTime.Today.Year - patient.DateOfBirth.Year)</div>
                    </td>
                    <td>
                        <div>@patient.PhoneNumber</div>
                        <div class="patient-meta fs-sm">@patient.Email</div>
                    </td>
                    <td><span class="badge badge-blue">@patient.Region</span></td>
                    <td>
                        <span class="badge @(patient.Status == PatientCrm.Core.Enums.PatientStatus.Active ? "badge-green" : patient.Status == PatientCrm.Core.Enums.PatientStatus.Deceased ? "badge-red" : "badge-gray")">
                            @patient.Status
                        </span>
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="/Patients/Details/@patient.Id" class="btn btn-sm btn-secondary">View</a>
                            <a href="/Patients/Edit/@patient.Id" class="btn btn-sm btn-secondary">Edit</a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                        <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🏥</div>
                        No patients found. <a href="/Patients/Create">Register your first patient</a>.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (ViewBag.TotalPages > 1)
    {
        <div style="padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 1rem;">
            <span class="text-muted fs-sm">
                Showing @((ViewBag.Page - 1) * ViewBag.PageSize + 1) – @Math.Min(ViewBag.Page * ViewBag.PageSize, ViewBag.Total) of @ViewBag.Total patients
            </span>
            <div class="pagination">
                @if (ViewBag.Page > 1)
                {
                    <a href="?search=@ViewBag.Search&page=@(ViewBag.Page - 1)" class="page-btn">‹</a>
                }
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a href="?search=@ViewBag.Search&page=@i" class="page-btn @(i == ViewBag.Page ? "active" : "")">@i</a>
                }
                @if (ViewBag.Page < ViewBag.TotalPages)
                {
                    <a href="?search=@ViewBag.Search&page=@(ViewBag.Page + 1)" class="page-btn">›</a>
                }
            </div>
        </div>
    }
</div>
