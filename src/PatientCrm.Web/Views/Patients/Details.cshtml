@model PatientCrm.Core.Entities.Patient
@using PatientCrm.Core.Entities
@{
    ViewData["Title"] = Model.FullName;

    // Helper: pick CSS class from tooth record state
    string GetToothClass(ToothRecord? t)
    {
        if (t == null) return "";
        if (t.IsMissing || t.IsExtracted) return "missing";
        if (t.HasDecay) return "tooth-decay";
        if (t.HasImplant) return "tooth-implant";
        if (t.HasRootCanal) return "tooth-rct";
        if (t.HasFilling) return "filled";
        if (t.HasCrown) return "crown";
        if (t.HasBridge || t.HasVeneer) return "tooth-bridge";
        return "";
    }
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a href="/Patients" style="color: var(--text-muted); text-decoration: none;">← Patients</a>
        <div class="patient-avatar" style="width: 52px; height: 52px; font-size: 1.1rem;">@(Model.FirstName.Substring(0,1))@(Model.LastName.Substring(0,1))</div>
        <div>
            <h1 class="page-title">@Model.FullName</h1>
            <div class="d-flex gap-2 align-items-center">
                @if (!string.IsNullOrEmpty(Model.NhsNumber))
                {
                    <span class="nhs-badge">NHS @Model.NhsNumber</span>
                }
                @if (!string.IsNullOrEmpty(Model.HscniNumber))
                {
                    <span class="hscni-badge">HSCNI @Model.HscniNumber</span>
                }
                <span class="badge @(Model.Status == PatientCrm.Core.Enums.PatientStatus.Active ? "badge-green" : "badge-gray")">@Model.Status</span>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Patients/Edit/@Model.Id" class="btn btn-secondary">Edit</a>
    </div>
</div>

<!-- Alerts -->
@foreach (var alert in Model.Alerts.Where(a => a.IsActive))
{
    <div class="alert @(alert.Severity == PatientCrm.Core.Enums.AlertSeverity.Critical ? "alert-danger" : alert.Severity == PatientCrm.Core.Enums.AlertSeverity.High ? "alert-warning" : "alert-info")">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <div><strong>@alert.Severity Alert:</strong> @alert.Title — @alert.Description</div>
    </div>
}

<!-- Allergies warning -->
@if (!string.IsNullOrEmpty(Model.Allergies))
{
    <div class="alert alert-danger">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <strong>⚠ ALLERGY ALERT:</strong>&nbsp;@Model.Allergies
    </div>
}

<!-- Tabs -->
<div class="tabs">
    <a class="tab-item active" href="#overview" onclick="showTab('overview', this)">Overview</a>
    <a class="tab-item" href="#notes" onclick="showTab('notes', this)">Clinical Notes (@Model.ClinicalNotes.Count)</a>
    <a class="tab-item" href="#appointments" onclick="showTab('appointments', this)">Appointments (@Model.Appointments.Count)</a>
    <a class="tab-item" href="#prescriptions" onclick="showTab('prescriptions', this)">Prescriptions (@Model.Prescriptions.Count)</a>
    <a class="tab-item" href="#images" onclick="showTab('images', this)">Images &amp; MRI (@Model.MedicalImages.Count)</a>
    @if (Model.DentalRecord != null)
    {
        <a class="tab-item" href="#dental" onclick="showTab('dental', this)">Dental Chart</a>
    }
    @if (Model.GpRecord != null)
    {
        <a class="tab-item" href="#gp" onclick="showTab('gp', this)">GP Record</a>
    }
</div>

<!-- Overview Tab -->
<div id="overview" class="tab-content">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
        <!-- Personal -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Personal Information</h3></div>
            <dl style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1rem;">
                <dt class="form-label">Full Name</dt><dd>@Model.FullName</dd>
                <dt class="form-label">Date of Birth</dt><dd>@Model.DateOfBirth.ToString("dd MMMM yyyy") (Age: @(DateTime.Today.Year - Model.DateOfBirth.Year))</dd>
                <dt class="form-label">Gender</dt><dd>@Model.Gender</dd>
                <dt class="form-label">Blood Group</dt><dd>@Model.BloodGroup</dd>
                <dt class="form-label">Ethnicity</dt><dd>@(Model.Ethnicity ?? "—")</dd>
                <dt class="form-label">Language</dt><dd>@(Model.PreferredLanguage ?? "English")</dd>
            </dl>
        </div>

        <!-- Contact -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Contact &amp; Address</h3></div>
            <dl style="display: grid; grid-template-columns: 1fr 2fr; gap: 0.5rem 1rem;">
                <dt class="form-label">Phone</dt><dd>@(Model.PhoneNumber ?? "—")</dd>
                <dt class="form-label">Mobile</dt><dd>@(Model.MobileNumber ?? "—")</dd>
                <dt class="form-label">Email</dt><dd>@(Model.Email ?? "—")</dd>
                <dt class="form-label">Address</dt>
                <dd>
                    @Model.AddressLine1<br />
                    @if (!string.IsNullOrEmpty(Model.AddressLine2)) { <span>@Model.AddressLine2<br /></span> }
                    @Model.City, @Model.Postcode<br />
                    <span class="badge badge-blue">@Model.Region</span>
                </dd>
            </dl>
        </div>

        <!-- Emergency Contact -->
        @if (!string.IsNullOrEmpty(Model.EmergencyContactName))
        {
            <div class="card">
                <div class="card-header"><h3 class="card-title">Emergency Contact</h3></div>
                <dl style="display: grid; grid-template-columns: 1fr 2fr; gap: 0.5rem 1rem;">
                    <dt class="form-label">Name</dt><dd>@Model.EmergencyContactName</dd>
                    <dt class="form-label">Relationship</dt><dd>@Model.EmergencyContactRelationship</dd>
                    <dt class="form-label">Phone</dt><dd>@Model.EmergencyContactPhone</dd>
                </dl>
            </div>
        }

        <!-- Registered GP -->
        <div class="card">
            <div class="card-header"><h3 class="card-title">Registered GP</h3></div>
            <dl style="display: grid; grid-template-columns: 1fr 2fr; gap: 0.5rem 1rem;">
                <dt class="form-label">GP Name</dt><dd>@(Model.RegisteredGpName ?? "—")</dd>
                <dt class="form-label">Practice</dt><dd>@(Model.RegisteredGpPractice ?? "—")</dd>
                <dt class="form-label">ODS Code</dt><dd>@(Model.RegisteredGpOdsCode ?? "—")</dd>
            </dl>
        </div>
    </div>
</div>

<!-- Clinical Notes Tab -->
<div id="notes" class="tab-content" style="display:none;">
    <div class="d-flex justify-between mb-4">
        <h3 class="card-title">Clinical Notes</h3>
        <button class="btn btn-primary btn-sm" onclick="document.getElementById('addNoteModal').classList.add('open')">+ Add Note</button>
    </div>

    <div class="timeline">
        @foreach (var note in Model.ClinicalNotes.OrderByDescending(n => n.NoteDate))
        {
            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <div class="timeline-header">
                        <div>
                            <span class="fw-600">@note.Title</span>
                            <span class="badge badge-blue" style="margin-left: 0.5rem;">@note.NoteType</span>
                            <span class="badge badge-purple" style="margin-left: 0.25rem;">@note.Discipline</span>
                        </div>
                        <span class="text-muted fs-sm">@note.NoteDate.ToString("dd MMM yyyy HH:mm") · @note.AuthorName</span>
                    </div>
                    @if (!string.IsNullOrEmpty(note.Subjective))
                    {
                        <div style="margin-top: 0.5rem;">
                            <strong>S:</strong> @note.Subjective<br/>
                            <strong>O:</strong> @note.Objective<br/>
                            <strong>A:</strong> @note.Assessment<br/>
                            <strong>P:</strong> @note.Plan
                        </div>
                    }
                    else
                    {
                        <p style="margin-top: 0.5rem; color: var(--text-secondary);">@note.Content</p>
                    }
                    @if (note.RequiresFollowUp && note.FollowUpDate.HasValue)
                    {
                        <div class="badge badge-amber" style="margin-top: 0.5rem;">Follow-up: @note.FollowUpDate.Value.ToString("dd MMM yyyy")</div>
                    }
                </div>
            </div>
        }
        @if (!Model.ClinicalNotes.Any())
        {
            <p class="text-muted">No clinical notes recorded yet.</p>
        }
    </div>
</div>

<!-- Appointments Tab -->
<div id="appointments" class="tab-content" style="display:none;">
    <div class="table-container">
        <table>
            <thead>
                <tr><th>Date/Time</th><th>Title</th><th>Type</th><th>Discipline</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.Appointments.OrderByDescending(a => a.StartTime))
                {
                    <tr>
                        <td>@appt.StartTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@appt.Title</td>
                        <td><span class="badge badge-blue">@appt.AppointmentType</span></td>
                        <td><span class="badge badge-purple">@appt.Discipline</span></td>
                        <td><span class="badge @(appt.Status == PatientCrm.Core.Enums.AppointmentStatus.Completed ? "badge-green" : appt.Status == PatientCrm.Core.Enums.AppointmentStatus.Cancelled ? "badge-red" : "badge-blue")">@appt.Status</span></td>
                    </tr>
                }
                @if (!Model.Appointments.Any())
                {
                    <tr><td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">No appointments recorded</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Prescriptions Tab -->
<div id="prescriptions" class="tab-content" style="display:none;">
    <div class="table-container">
        <table>
            <thead>
                <tr><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Prescribed</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var rx in Model.Prescriptions.OrderByDescending(p => p.PrescribedDate))
                {
                    <tr>
                        <td>
                            <div class="fw-600">@rx.MedicationName</div>
                            @if (rx.IsControlledDrug)
                            {
                                <span class="badge badge-red">CD</span>
                            }
                        </td>
                        <td>@rx.Dosage @rx.Unit</td>
                        <td>@rx.Frequency (@rx.Route)</td>
                        <td>@rx.PrescribedDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @(rx.Status == PatientCrm.Core.Enums.PrescriptionStatus.Active ? "badge-green" : "badge-gray")">@rx.Status</span></td>
                    </tr>
                }
                @if (!Model.Prescriptions.Any())
                {
                    <tr><td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">No prescriptions recorded</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Images & MRI Tab -->
<div id="images" class="tab-content" style="display:none;">
    <div class="d-flex justify-between mb-4">
        <h3 class="card-title">Medical Images &amp; MRI Scans</h3>
        <button class="btn btn-primary btn-sm" onclick="document.getElementById('uploadImageModal').classList.add('open')">+ Upload Image</button>
    </div>

    <div class="image-grid">
        @foreach (var img in Model.MedicalImages.OrderByDescending(i => i.ImageDate))
        {
            <div class="image-card">
                @if (img.ImageType == PatientCrm.Core.Enums.ImageType.MriScan || img.ImageType == PatientCrm.Core.Enums.ImageType.CtScan)
                {
                    <div class="mri-viewer" style="height: 135px; font-size: 0.8rem;">
                        <div style="text-align: center;">
                            <div>⬛ @img.ImageType</div>
                            <div style="font-size: 0.65rem; margin-top: 0.25rem;">@img.Modality</div>
                        </div>
                    </div>
                }
                else
                {
                    <img src="@img.StoragePath" alt="@img.Title" loading="lazy" onerror="this.src='/images/placeholder.png'" />
                }
                <div class="image-card-info">
                    <div class="image-card-title">@img.Title</div>
                    <div class="image-card-type">@img.ImageType · @img.ImageDate.ToString("dd MMM yyyy")</div>
                    @if (!string.IsNullOrEmpty(img.BodyPart))
                    {
                        <div class="patient-meta">@img.BodyPart</div>
                    }
                </div>
            </div>
        }
        @if (!Model.MedicalImages.Any())
        {
            <div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 3rem;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">🩻</div>
                No images uploaded yet.
            </div>
        }
    </div>
</div>

<!-- Dental Chart Tab -->
@if (Model.DentalRecord != null)
{
    // Serialize tooth records for JS lookup
    var toothData = Model.DentalRecord.ToothRecords
        .Where(tr => !tr.IsDeleted)
        .ToDictionary(tr => tr.ToothNumber.ToString(), tr => new {
            missing = tr.IsMissing, extracted = tr.IsExtracted,
            decay = tr.HasDecay, filling = tr.HasFilling, fillingType = tr.FillingType,
            crown = tr.HasCrown, crownMaterial = tr.CrownMaterial,
            bridge = tr.HasBridge, veneer = tr.HasVeneer, implant = tr.HasImplant,
            rootCanal = tr.HasRootCanal, abscess = tr.HasAbscess, fracture = tr.HasFracture,
            sensitivity = tr.HasSensitivity, gumDisease = tr.HasGumDisease,
            chipping = tr.HasChipping, wearing = tr.HasWearing, overhang = tr.HasOverhang,
            watchWait = tr.IsWatchAndWait, surfaces = tr.Surfaces ?? "",
            notes = tr.Notes ?? "", plan = tr.TreatmentPlan ?? ""
        });
    var toothJson = System.Text.Json.JsonSerializer.Serialize(toothData);

    <div id="dental" class="tab-content" style="display:none;">
        <div class="d-flex justify-between align-items-center mb-4">
            <div>
                <h2 class="page-title" style="font-size: 1.25rem;">Dental Chart</h2>
                <p class="page-subtitle">Click any tooth to view or record conditions</p>
            </div>
            <a href="/Patients/UploadImage?patientId=@Model.Id&defaultType=DentalXRay"
               class="btn btn-secondary btn-sm"
               onclick="document.getElementById('uploadImageModal').classList.add('open'); document.querySelector('[name=imageType]').value='DentalXRay'; return false;">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg>
                Upload X-Ray / OPG
            </a>
        </div>

        <!-- Summary stats -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.5rem; margin-bottom: 1.5rem;">
            @{
                var teeth = Model.DentalRecord.ToothRecords.Where(t => !t.IsDeleted).ToList();
                int totalMissing = teeth.Count(t => t.IsMissing || t.IsExtracted);
                int totalFilled = teeth.Count(t => t.HasFilling);
                int totalCrowns = teeth.Count(t => t.HasCrown);
                int totalImplants = teeth.Count(t => t.HasImplant);
                int totalDecay = teeth.Count(t => t.HasDecay);
                int totalRct = teeth.Count(t => t.HasRootCanal);
            }
            <div class="stat-card" style="padding: 0.75rem; flex-direction: column; text-align: center; gap: 0.25rem;">
                <div class="fw-700" style="font-size: 1.25rem; color: var(--danger);">@totalDecay</div>
                <div class="patient-meta">Decay</div>
            </div>
            <div class="stat-card" style="padding: 0.75rem; flex-direction: column; text-align: center; gap: 0.25rem;">
                <div class="fw-700" style="font-size: 1.25rem; color: #d97706;">@totalFilled</div>
                <div class="patient-meta">Fillings</div>
            </div>
            <div class="stat-card" style="padding: 0.75rem; flex-direction: column; text-align: center; gap: 0.25rem;">
                <div class="fw-700" style="font-size: 1.25rem; color: var(--primary);">@totalCrowns</div>
                <div class="patient-meta">Crowns</div>
            </div>
            <div class="stat-card" style="padding: 0.75rem; flex-direction: column; text-align: center; gap: 0.25rem;">
                <div class="fw-700" style="font-size: 1.25rem; color: #15803d;">@totalImplants</div>
                <div class="patient-meta">Implants</div>
            </div>
            <div class="stat-card" style="padding: 0.75rem; flex-direction: column; text-align: center; gap: 0.25rem;">
                <div class="fw-700" style="font-size: 1.25rem; color: var(--secondary);">@totalRct</div>
                <div class="patient-meta">Root Canals</div>
            </div>
            <div class="stat-card" style="padding: 0.75rem; flex-direction: column; text-align: center; gap: 0.25rem;">
                <div class="fw-700" style="font-size: 1.25rem; color: #dc2626;">@totalMissing</div>
                <div class="patient-meta">Missing</div>
            </div>
        </div>

        <!-- FDI dental chart -->
        <div class="card">
            <div style="overflow-x: auto; padding: 0.5rem 0;">
                <!-- Upper arch label -->
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; padding: 0 1rem;">
                    <span class="patient-meta" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; min-width: 60px; text-align: right;">Upper R</span>
                    <div style="flex: 1; height: 1px; background: var(--border);"></div>
                    <span class="patient-meta" style="font-size: 0.65rem;">Upper L</span>
                </div>

                <!-- Upper teeth row (FDI: right side 18-11, left side 21-28) -->
                <div style="display: flex; justify-content: center; gap: 3px; padding: 0 1rem; flex-wrap: nowrap;">
                    @for (int i = 18; i >= 11; i--)
                    {
                        var t = Model.DentalRecord.ToothRecords.FirstOrDefault(tr => tr.ToothNumber == i && !tr.IsDeleted);
                        var cssClass = GetToothClass(t);
                        <button type="button" class="tooth tooth-btn @cssClass" data-tooth="@i" title="Tooth @i — click to edit">
                            <span style="font-size: 0.6rem; display: block; line-height: 1.2;">@i</span>
                        </button>
                    }
                    <div style="width: 2px; background: var(--border); margin: 0 4px; border-radius: 2px;"></div>
                    @for (int i = 21; i <= 28; i++)
                    {
                        var t = Model.DentalRecord.ToothRecords.FirstOrDefault(tr => tr.ToothNumber == i && !tr.IsDeleted);
                        var cssClass = GetToothClass(t);
                        <button type="button" class="tooth tooth-btn @cssClass" data-tooth="@i" title="Tooth @i — click to edit">
                            <span style="font-size: 0.6rem; display: block; line-height: 1.2;">@i</span>
                        </button>
                    }
                </div>

                <div style="height: 12px;"></div>

                <!-- Lower teeth row (FDI: right side 48-41, left side 31-38) -->
                <div style="display: flex; justify-content: center; gap: 3px; padding: 0 1rem; flex-wrap: nowrap;">
                    @for (int i = 48; i >= 41; i--)
                    {
                        var t = Model.DentalRecord.ToothRecords.FirstOrDefault(tr => tr.ToothNumber == i && !tr.IsDeleted);
                        var cssClass = GetToothClass(t);
                        <button type="button" class="tooth tooth-btn @cssClass" data-tooth="@i" title="Tooth @i — click to edit">
                            <span style="font-size: 0.6rem; display: block; line-height: 1.2;">@i</span>
                        </button>
                    }
                    <div style="width: 2px; background: var(--border); margin: 0 4px; border-radius: 2px;"></div>
                    @for (int i = 31; i <= 38; i++)
                    {
                        var t = Model.DentalRecord.ToothRecords.FirstOrDefault(tr => tr.ToothNumber == i && !tr.IsDeleted);
                        var cssClass = GetToothClass(t);
                        <button type="button" class="tooth tooth-btn @cssClass" data-tooth="@i" title="Tooth @i — click to edit">
                            <span style="font-size: 0.6rem; display: block; line-height: 1.2;">@i</span>
                        </button>
                    }
                </div>

                <!-- Lower arch label -->
                <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem; padding: 0 1rem;">
                    <span class="patient-meta" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; min-width: 60px; text-align: right;">Lower R</span>
                    <div style="flex: 1; height: 1px; background: var(--border);"></div>
                    <span class="patient-meta" style="font-size: 0.65rem;">Lower L</span>
                </div>
            </div>

            <!-- Legend -->
            <div class="d-flex gap-3" style="padding: 1rem; flex-wrap: wrap; border-top: 1px solid var(--border);">
                <div class="d-flex align-items-center gap-1"><span class="tooth" style="width: 22px; height: 22px; font-size: 0; pointer-events: none;"></span><span class="fs-sm">Healthy</span></div>
                <div class="d-flex align-items-center gap-1"><span class="tooth" style="width: 22px; height: 22px; font-size: 0; pointer-events: none; background: #fee2e2;"></span><span class="fs-sm text-danger">Decay</span></div>
                <div class="d-flex align-items-center gap-1"><span class="tooth filled" style="width: 22px; height: 22px; font-size: 0; pointer-events: none;"></span><span class="fs-sm">Filling</span></div>
                <div class="d-flex align-items-center gap-1"><span class="tooth crown" style="width: 22px; height: 22px; font-size: 0; pointer-events: none;"></span><span class="fs-sm">Crown</span></div>
                <div class="d-flex align-items-center gap-1"><span class="tooth" style="width: 22px; height: 22px; font-size: 0; pointer-events: none; background: #dcfce7;"></span><span class="fs-sm">Implant</span></div>
                <div class="d-flex align-items-center gap-1"><span class="tooth" style="width: 22px; height: 22px; font-size: 0; pointer-events: none; background: #fce7f3;"></span><span class="fs-sm">Root Canal</span></div>
                <div class="d-flex align-items-center gap-1"><span class="tooth extracted" style="width: 22px; height: 22px; font-size: 0; pointer-events: none;"></span><span class="fs-sm">Extracted</span></div>
                <div class="d-flex align-items-center gap-1"><span class="tooth missing" style="width: 22px; height: 22px; font-size: 0; pointer-events: none;"></span><span class="fs-sm">Missing</span></div>
                <div class="d-flex align-items-center gap-1"><span class="tooth" style="width: 22px; height: 22px; font-size: 0; pointer-events: none; background: #ede9fe;"></span><span class="fs-sm">Bridge/Veneer</span></div>
            </div>
        </div>

        <!-- Dental record summary -->
        <div class="card" style="margin-top: 1rem;">
            <div class="card-header"><h3 class="card-title">Dental Record Summary</h3></div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                <div>
                    <dt class="form-label">Last Examination</dt>
                    <dd>@(Model.DentalRecord.LastExaminationDate?.ToString("dd MMM yyyy") ?? "—")</dd>
                </div>
                <div>
                    <dt class="form-label">Last Hygiene Visit</dt>
                    <dd>@(Model.DentalRecord.LastHygieneAppointment?.ToString("dd MMM yyyy") ?? "—")</dd>
                </div>
                <div>
                    <dt class="form-label">Last X-Ray</dt>
                    <dd>@(Model.DentalRecord.LastXRayDate?.ToString("dd MMM yyyy") ?? "—")</dd>
                </div>
                <div>
                    <dt class="form-label">Periodontal Status</dt>
                    <dd>@(Model.DentalRecord.PeriodontalStatus ?? "—")</dd>
                </div>
                @if (Model.DentalRecord.ReferredToOralSurgery || Model.DentalRecord.ReferredToOrthodontics || Model.DentalRecord.ReferredToPeriodontist)
                {
                    <div>
                        <dt class="form-label">Referrals</dt>
                        <dd class="d-flex gap-1" style="flex-wrap: wrap;">
                            @if (Model.DentalRecord.ReferredToOralSurgery) { <span class="badge badge-red">Oral Surgery</span> }
                            @if (Model.DentalRecord.ReferredToOrthodontics) { <span class="badge badge-blue">Orthodontics</span> }
                            @if (Model.DentalRecord.ReferredToPeriodontist) { <span class="badge badge-amber">Periodontist</span> }
                        </dd>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ── Tooth Detail Modal ─────────────────────────────────────────────── -->
    <div class="modal-backdrop" id="toothModal">
        <div class="modal" style="max-width: 680px;">
            <div class="modal-header">
                <div>
                    <h3 class="modal-title" id="toothModalTitle">Tooth #<span id="toothModalNum"></span></h3>
                    <p class="page-subtitle" style="margin: 0;">Record conditions and treatment for this tooth</p>
                </div>
                <button class="btn-icon" type="button" onclick="document.getElementById('toothModal').classList.remove('open')">✕</button>
            </div>
            <form method="post" action="/Patients/SaveToothRecord" id="toothForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="patientId" value="@Model.Id" />
                <input type="hidden" name="dentalRecordId" value="@Model.DentalRecord.Id" />
                <input type="hidden" name="toothNumber" id="toothNumberInput" value="" />

                <!-- Status Grid -->
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 1rem;">
                    @{
                        var conditions = new[]
                        {
                            ("IsMissing", "🚫", "Missing", "badge-gray"),
                            ("IsExtracted", "❌", "Extracted", "badge-red"),
                            ("HasDecay", "🦠", "Decay / Caries", "badge-red"),
                            ("HasFilling", "⬛", "Filling", "badge-amber"),
                            ("HasCrown", "👑", "Crown", "badge-purple"),
                            ("HasBridge", "🌉", "Bridge Abutment", "badge-purple"),
                            ("HasVeneer", "✨", "Veneer", "badge-blue"),
                            ("HasImplant", "🔩", "Implant", "badge-green"),
                            ("HasRootCanal", "🔴", "Root Canal", "badge-red"),
                            ("HasAbscess", "💥", "Abscess / Swelling", "badge-red"),
                            ("HasFracture", "💔", "Fracture / Crack", "badge-amber"),
                            ("HasSensitivity", "❄️", "Sensitivity", "badge-blue"),
                            ("HasGumDisease", "🩸", "Gum Disease", "badge-red"),
                            ("HasChipping", "⚡", "Chipping / Wear", "badge-amber"),
                            ("IsWatchAndWait", "👁️", "Watch &amp; Wait", "badge-gray"),
                        };
                    }
                    @foreach (var (field, icon, label, _) in conditions)
                    {
                        <label style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-surface-2); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.5rem 0.625rem; cursor: pointer; transition: all 0.15s;" class="condition-check">
                            <input type="checkbox" name="@field" value="true" id="chk_@field"
                                   style="width: 16px; height: 16px; cursor: pointer; flex-shrink: 0;" />
                            <span style="font-size: 0.8rem; font-weight: 500;">@icon @label</span>
                        </label>
                    }
                </div>

                <!-- Filling Type (conditional) -->
                <div id="fillingTypeRow" style="display: none;" class="form-row">
                    <div class="form-group">
                        <label class="form-label">Filling Material</label>
                        <select name="FillingType" class="form-control">
                            <option value="">— Select —</option>
                            <option value="Amalgam">Amalgam (silver)</option>
                            <option value="Composite">Composite (tooth-coloured)</option>
                            <option value="GlassIonomer">Glass Ionomer</option>
                            <option value="Gold">Gold</option>
                            <option value="Ceramic">Ceramic / Porcelain</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Crown Material</label>
                        <select name="CrownMaterial" class="form-control">
                            <option value="">— Select —</option>
                            <option value="PFM">PFM (Porcelain-fused-to-metal)</option>
                            <option value="AllCeramic">All-Ceramic / Zirconia</option>
                            <option value="Metal">Full Metal</option>
                            <option value="EMax">e.max Lithium Disilicate</option>
                        </select>
                    </div>
                </div>

                <!-- Surfaces Affected -->
                <div class="form-group">
                    <label class="form-label">Surfaces Affected</label>
                    <div class="d-flex gap-2" style="flex-wrap: wrap;">
                        @foreach (var surf in new[] { ("M","Mesial"), ("D","Distal"), ("B","Buccal"), ("L","Lingual"), ("O","Occlusal"), ("P","Palatal"), ("I","Incisal") })
                        {
                            <label style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; cursor: pointer;">
                                <input type="checkbox" class="surface-check" data-surface="@surf.Item1"
                                       style="width: 15px; height: 15px; cursor: pointer;" />
                                <span><strong>@surf.Item1</strong> — @surf.Item2</span>
                            </label>
                        }
                    </div>
                    <input type="hidden" name="Surfaces" id="surfacesInput" value="" />
                </div>

                <!-- Notes & Plan -->
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Clinical Notes</label>
                        <textarea name="Notes" id="toothNotes" class="form-control" rows="2"
                                  placeholder="Observations for this tooth…"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Treatment Plan</label>
                        <textarea name="TreatmentPlan" id="toothPlan" class="form-control" rows="2"
                                  placeholder="Planned treatment…"></textarea>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Treatment Date</label>
                        <input type="date" name="TreatmentDate" id="treatmentDate" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Next Review Date</label>
                        <input type="date" name="NextReviewDate" id="nextReviewDate" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-between" style="margin-top: 1rem;">
                    <button type="button" class="btn btn-secondary"
                        onclick="document.getElementById('toothModal').classList.remove('open')">Cancel</button>
                    <button type="submit" class="btn btn-primary">💾 Save Tooth Record</button>
                </div>
            </form>
        </div>
    </div>

    <script>
    (function() {
    // Tooth data from server
    var toothData = @Html.Raw(toothJson);

    // Compute display class for each tooth dynamically (matches server-side GetToothClass)
    function getToothDisplayClass(d) {
        if (!d) return '';
        if (d.missing || d.extracted) return 'missing';
        if (d.decay) return 'tooth-decay';
        if (d.implant) return 'tooth-implant';
        if (d.rootCanal) return 'tooth-rct';
        if (d.filling) return 'filled';
        if (d.crown) return 'crown';
        if (d.bridge || d.veneer) return 'tooth-bridge';
        return '';
    }

    // Apply colours to all teeth on page load
    document.querySelectorAll('[data-tooth]').forEach(btn => {
        var num = btn.dataset.tooth;
        var d = toothData[num];
        btn.className = btn.className.replace(/\btooth-\S+\b/g, '').trim();
        if (d) {
            var cls = getToothDisplayClass(d);
            if (cls) btn.classList.add(cls);
        }
    });

    // Open modal when tooth clicked
    document.querySelectorAll('[data-tooth]').forEach(btn => {
        btn.addEventListener('click', function() {
            var num = this.dataset.tooth;
            var d = toothData[num] || {};

            // Set heading
            document.getElementById('toothModalNum').textContent = num;
            document.getElementById('toothNumberInput').value = num;

            // Reset all checkboxes
            document.querySelectorAll('#toothForm input[type=checkbox]').forEach(c => c.checked = false);

            // Populate checkbox states from data
            if (d.missing)     setCheck('IsMissing', true);
            if (d.extracted)   setCheck('IsExtracted', true);
            if (d.decay)       setCheck('HasDecay', true);
            if (d.filling)     setCheck('HasFilling', true);
            if (d.crown)       setCheck('HasCrown', true);
            if (d.bridge)      setCheck('HasBridge', true);
            if (d.veneer)      setCheck('HasVeneer', true);
            if (d.implant)     setCheck('HasImplant', true);
            if (d.rootCanal)   setCheck('HasRootCanal', true);
            if (d.abscess)     setCheck('HasAbscess', true);
            if (d.fracture)    setCheck('HasFracture', true);
            if (d.sensitivity) setCheck('HasSensitivity', true);
            if (d.gumDisease)  setCheck('HasGumDisease', true);
            if (d.chipping)    setCheck('HasChipping', true);
            if (d.watchWait)   setCheck('IsWatchAndWait', true);

            // Filling / crown material
            var ft = document.querySelector('[name=FillingType]');
            var cm = document.querySelector('[name=CrownMaterial]');
            if (ft) ft.value = d.fillingType || '';
            if (cm) cm.value = d.crownMaterial || '';

            // Surfaces
            var surfaces = (d.surfaces || '').split(',').map(s => s.trim());
            document.querySelectorAll('.surface-check').forEach(c => {
                c.checked = surfaces.includes(c.dataset.surface);
            });
            document.getElementById('surfacesInput').value = d.surfaces || '';

            // Notes/Plan
            document.getElementById('toothNotes').value = d.notes || '';
            document.getElementById('toothPlan').value = d.plan || '';

            toggleFillingRow();
            document.getElementById('toothModal').classList.add('open');
        });
    });

    function setCheck(name, val) {
        var el = document.getElementById('chk_' + name);
        if (el) el.checked = val;
    }

    function toggleFillingRow() {
        var show = document.getElementById('chk_HasFilling')?.checked ||
                   document.getElementById('chk_HasCrown')?.checked;
        var row = document.getElementById('fillingTypeRow');
        if (row) row.style.display = show ? 'grid' : 'none';
    }

    document.getElementById('chk_HasFilling')?.addEventListener('change', toggleFillingRow);
    document.getElementById('chk_HasCrown')?.addEventListener('change', toggleFillingRow);

    // Collect surface checkboxes into hidden input on submit
    document.querySelectorAll('.surface-check').forEach(c => {
        c.addEventListener('change', function() {
            var selected = [];
            document.querySelectorAll('.surface-check:checked').forEach(x => selected.push(x.dataset.surface));
            document.getElementById('surfacesInput').value = selected.join(',');
        });
    });

    // Style condition checkboxes on hover/check
    document.querySelectorAll('.condition-check input').forEach(cb => {
        cb.addEventListener('change', function() {
            this.closest('.condition-check').style.borderColor = this.checked ? 'var(--primary)' : 'var(--border)';
            this.closest('.condition-check').style.background = this.checked ? 'var(--primary-light)' : 'var(--bg-surface-2)';
        });
    });
    })();
    </script>
}

<!-- GP Record Tab -->
@if (Model.GpRecord != null)
{
    <div id="gp" class="tab-content" style="display:none;">
        <div class="card">
            <div class="card-header"><h3 class="card-title">GP Clinical Record</h3></div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">
                <div>
                    <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.5rem;">Long Term Conditions</h4>
                    <div class="d-flex gap-1" style="flex-wrap: wrap;">
                        @if (Model.GpRecord.HasDiabetes) { <span class="badge badge-amber">Diabetes @Model.GpRecord.DiabetesType</span> }
                        @if (Model.GpRecord.HasHypertension) { <span class="badge badge-red">Hypertension</span> }
                        @if (Model.GpRecord.HasAsthma) { <span class="badge badge-blue">Asthma</span> }
                        @if (Model.GpRecord.HasCopd) { <span class="badge badge-amber">COPD</span> }
                        @if (Model.GpRecord.HasHeartDisease) { <span class="badge badge-red">Heart Disease</span> }
                        @if (Model.GpRecord.HasStrokeHistory) { <span class="badge badge-purple">Stroke History</span> }
                        @if (Model.GpRecord.HasCancer) { <span class="badge badge-red">Cancer</span> }
                        @if (Model.GpRecord.HasMentalHealthCondition) { <span class="badge badge-purple">Mental Health</span> }
                        @if (!Model.GpRecord.HasDiabetes && !Model.GpRecord.HasHypertension && !Model.GpRecord.HasAsthma && !Model.GpRecord.HasCopd) { <span class="text-muted fs-sm">None recorded</span> }
                    </div>
                </div>
                <div>
                    <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.5rem;">Disease Registers</h4>
                    <div class="d-flex gap-1" style="flex-wrap: wrap;">
                        @if (Model.GpRecord.OnPalliativeCareRegister) { <span class="badge badge-gray">Palliative Care</span> }
                        @if (Model.GpRecord.OnDementiaRegister) { <span class="badge badge-purple">Dementia</span> }
                        @if (Model.GpRecord.OnEpilepsyRegister) { <span class="badge badge-amber">Epilepsy</span> }
                        @if (Model.GpRecord.OnAtrialFibrillationRegister) { <span class="badge badge-red">Atrial Fibrillation</span> }
                    </div>
                </div>
                <div>
                    <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.5rem;">Baseline Observations</h4>
                    @if (Model.GpRecord.BaselineBloodPressureSystolic.HasValue)
                    {
                        <div class="fs-sm">BP: @Model.GpRecord.BaselineBloodPressureSystolic/@Model.GpRecord.BaselineBloodPressureDiastolic mmHg</div>
                    }
                    @if (Model.GpRecord.BaselineHba1c.HasValue)
                    {
                        <div class="fs-sm">HbA1c: @Model.GpRecord.BaselineHba1c mmol/mol</div>
                    }
                    @if (Model.GpRecord.BaselineBmi.HasValue)
                    {
                        <div class="fs-sm">BMI: @Model.GpRecord.BaselineBmi</div>
                    }
                    @if (Model.GpRecord.BaselineCholesterol.HasValue)
                    {
                        <div class="fs-sm">Cholesterol: @Model.GpRecord.BaselineCholesterol mmol/L</div>
                    }
                </div>
            </div>

            @if (Model.GpRecord.Referrals.Any())
            {
                <div style="margin-top: 1.5rem;">
                    <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.75rem;">Referrals</h4>
                    <table>
                        <thead>
                            <tr><th>Specialty</th><th>Hospital</th><th>Date</th><th>Urgent</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var referral in Model.GpRecord.Referrals)
                            {
                                <tr>
                                    <td>@referral.Specialty</td>
                                    <td>@(referral.HospitalName ?? "—")</td>
                                    <td>@referral.ReferralDate.ToString("dd MMM yyyy")</td>
                                    <td>@(referral.IsUrgent ? "⚠ Yes" : "No")</td>
                                    <td><span class="badge badge-blue">@(referral.Status ?? "Pending")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<!-- Add Note Modal -->
<div class="modal-backdrop" id="addNoteModal">
    <div class="modal" style="max-width: 700px;">
        <div class="modal-header">
            <h3 class="modal-title">Add Clinical Note</h3>
            <button class="btn-icon" onclick="document.getElementById('addNoteModal').classList.remove('open')">✕</button>
        </div>
        <form method="post" action="/Patients/AddNote">
            @Html.AntiForgeryToken()
            <input type="hidden" name="patientId" value="@Model.Id" />
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Note Type</label>
                    <select name="NoteType" class="form-control">
                        @foreach (var nt in Enum.GetValues<PatientCrm.Core.Enums.NoteType>())
                        {
                            <option value="@nt">@nt</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Discipline</label>
                    <select name="Discipline" class="form-control">
                        @foreach (var d in Enum.GetValues<PatientCrm.Core.Enums.DisciplineType>())
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Title</label>
                <input name="Title" class="form-control" required placeholder="e.g. Annual Diabetes Review" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Subjective (S)</label>
                    <textarea name="Subjective" class="form-control" rows="2" placeholder="What the patient reports..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Objective (O)</label>
                    <textarea name="Objective" class="form-control" rows="2" placeholder="Examination findings..."></textarea>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Assessment (A)</label>
                    <textarea name="Assessment" class="form-control" rows="2" placeholder="Diagnosis / impression..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Plan (P)</label>
                    <textarea name="Plan" class="form-control" rows="2" placeholder="Treatment / management plan..."></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Full Note</label>
                <textarea name="Content" class="form-control" rows="3" required placeholder="Complete note text..."></textarea>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">SNOMED Code</label>
                    <input name="SnomedCode" class="form-control" placeholder="e.g. 44054006" />
                </div>
                <div class="form-group form-check" style="align-self: flex-end; margin-bottom: 1rem;">
                    <input type="checkbox" name="RequiresFollowUp" id="followUpCheck" value="true" />
                    <label for="followUpCheck" class="form-label" style="margin: 0;">Requires Follow-Up</label>
                </div>
            </div>
            <div class="d-flex justify-between" style="margin-top: 1rem;">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('addNoteModal').classList.remove('open')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Note</button>
            </div>
        </form>
    </div>
</div>

