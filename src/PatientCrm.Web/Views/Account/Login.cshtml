@{
    ViewData["Title"] = "Sign In";
    Layout = "_LoginLayout";
}

<div style="width: 100%; max-width: 440px;">
    <!-- Logo area -->
    <div style="text-align: center; margin-bottom: 2rem;">
        <div style="width: 64px; height: 64px; background: white; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem; box-shadow: 0 8px 24px rgba(0,0,0,0.15);">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#005EB8" stroke-width="2.5">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
        </div>
        <h1 style="color: white; font-size: 1.75rem; font-weight: 700; margin-bottom: 0.25rem;">PatientCRM</h1>
        <p style="color: rgba(255,255,255,0.7); font-size: 0.875rem;">NHS & HSCNI Compliant Clinical Management</p>
    </div>

    <!-- Card -->
    <div style="background: white; border-radius: 16px; padding: 2rem; box-shadow: 0 20px 60px rgba(0,0,0,0.2);">
        <h2 style="font-size: 1.25rem; font-weight: 600; color: #0f172a; margin-bottom: 0.25rem;">Sign in to your account</h2>
        <p style="font-size: 0.875rem; color: #64748b; margin-bottom: 1.5rem;">Enter your credentials to continue</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="margin-bottom: 1rem;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="form-group">
                <label class="form-label" for="email">Email Address</label>
                <input type="email" name="email" id="email" class="form-control" required
                       placeholder="doctor@practice.nhs.uk" autocomplete="username" />
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <input type="password" name="password" id="password" class="form-control" required
                       placeholder="Enter your password" autocomplete="current-password" />
            </div>

            <div class="d-flex justify-between align-items-center" style="margin-bottom: 1.25rem;">
                <label class="form-check">
                    <input type="checkbox" name="rememberMe" value="true" />
                    <span style="font-size: 0.875rem; color: #475569;">Remember me</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">
                Sign In
            </button>
        </form>

        <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid #e2e8f0; font-size: 0.75rem; color: #94a3b8; text-align: center;">
            <p>🔒 Secure NHS &amp; HSCNI Compliant System</p>
            <p>Protected under UK Data Protection Act 2018 &amp; GDPR</p>
        </div>
    </div>

    <!-- Demo credentials -->
    <div style="background: rgba(255,255,255,0.15); border-radius: 12px; padding: 1rem; margin-top: 1rem;">
        <p style="color: rgba(255,255,255,0.9); font-size: 0.75rem; font-weight: 600; margin-bottom: 0.5rem;">Demo Credentials</p>
        <p style="color: rgba(255,255,255,0.75); font-size: 0.75rem;">GP: dr.smith&#64;greenfield.nhs.uk / Doctor&#64;2024!</p>
        <p style="color: rgba(255,255,255,0.75); font-size: 0.75rem;">Admin: superadmin&#64;patientcrm.nhs.uk / Admin&#64;2024!</p>
    </div>
</div>
