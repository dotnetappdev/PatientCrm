@{
    ViewData["Title"] = "Sign In";
    Layout = "_LoginLayout";
}

<div style="width: 100%; max-width: 440px;">
    <!-- Logo area -->
    <div style="text-align: center; margin-bottom: 2rem;">
        <div style="width: 64px; height: 64px; background: white; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem; box-shadow: 0 8px 24px rgba(0,0,0,0.15);">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#005EB8" stroke-width="2.5">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
        </div>
        <h1 style="color: white; font-size: 1.75rem; font-weight: 700; margin-bottom: 0.25rem;">PatientCRM</h1>
        <p style="color: rgba(255,255,255,0.7); font-size: 0.875rem;">NHS &amp; HSCNI Compliant Clinical Management</p>
    </div>

    <!-- Card -->
    <div style="background: white; border-radius: 16px; padding: 2rem; box-shadow: 0 20px 60px rgba(0,0,0,0.2);">
        <h2 style="font-size: 1.25rem; font-weight: 600; color: #0f172a; margin-bottom: 0.25rem;">Sign in to your account</h2>
        <p style="font-size: 0.875rem; color: #64748b; margin-bottom: 1.5rem;">Enter your credentials to continue</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="margin-bottom: 1rem;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" id="loginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="form-group">
                <label class="form-label" for="email">Email Address</label>
                <input type="email" name="email" id="email" class="form-control" required
                       placeholder="doctor@@practice.nhs.uk" autocomplete="username" />
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <input type="password" name="password" id="password" class="form-control" required
                       placeholder="Enter your password" autocomplete="current-password" />
            </div>

            <div class="d-flex justify-between align-items-center" style="margin-bottom: 1.25rem;">
                <label class="form-check">
                    <input type="checkbox" name="rememberMe" value="true" />
                    <span style="font-size: 0.875rem; color: #475569;">Remember me</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">
                Sign In
            </button>
        </form>

        <!-- Passkey / Biometric login -->
        <div style="margin-top: 1rem; text-align: center;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                <div style="flex: 1; height: 1px; background: #e2e8f0;"></div>
                <span style="font-size: 0.75rem; color: #94a3b8;">or</span>
                <div style="flex: 1; height: 1px; background: #e2e8f0;"></div>
            </div>
            <button type="button" id="passkeyBtn" onclick="signInWithPasskey()"
                    style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.875rem; color: #334155; font-family: inherit;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                </svg>
                Sign in with Passkey
            </button>
        </div>

        <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid #e2e8f0; font-size: 0.75rem; color: #94a3b8; text-align: center;">
            <p>&#x1F512; Secure NHS &amp; HSCNI Compliant System</p>
            <p>Protected under UK Data Protection Act 2018 &amp; GDPR</p>
        </div>
    </div>

    <!-- Demo credentials -->
    <div style="background: rgba(255,255,255,0.15); border-radius: 12px; padding: 1rem; margin-top: 1rem;">
        <p style="color: rgba(255,255,255,0.9); font-size: 0.75rem; font-weight: 600; margin-bottom: 0.5rem;">Demo Credentials</p>
        <p style="color: rgba(255,255,255,0.75); font-size: 0.75rem;">GP: dr.smith&#64;greenfield.nhs.uk / Doctor&#64;2024!</p>
        <p style="color: rgba(255,255,255,0.75); font-size: 0.75rem;">Admin: superadmin&#64;patientcrm.nhs.uk / Admin&#64;2024!</p>
    </div>
</div>

<script>
const API_BASE = '';

async function signInWithPasskey() {
    const email = document.getElementById('email').value.trim();
    try {
        // Get assertion options from API
        const optResp = await fetch(API_BASE + '/api/auth/passkey/assertion-options', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email || null })
        });
        if (!optResp.ok) { alert('Failed to get passkey options'); return; }

        const options = await optResp.json();
        options.challenge = base64UrlDecode(options.challenge);
        if (options.allowCredentials) {
            options.allowCredentials = options.allowCredentials.map(c => ({
                ...c, id: base64UrlDecode(c.id)
            }));
        }

        const assertion = await navigator.credentials.get({ publicKey: options });
        if (!assertion) { alert('Passkey authentication failed'); return; }

        const assertionData = {
            id: assertion.id,
            rawId: base64UrlEncode(assertion.rawId),
            type: assertion.type,
            response: {
                authenticatorData: base64UrlEncode(assertion.response.authenticatorData),
                clientDataJSON: base64UrlEncode(assertion.response.clientDataJSON),
                signature: base64UrlEncode(assertion.response.signature),
                userHandle: assertion.response.userHandle ? base64UrlEncode(assertion.response.userHandle) : null
            }
        };

        const loginResp = await fetch(API_BASE + '/api/auth/passkey/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(assertionData)
        });

        if (!loginResp.ok) { alert('Passkey login failed. Please try again.'); return; }
        const result = await loginResp.json();

        // Use the JWT to establish a session via the normal login endpoint
        // For now redirect to a special passkey callback
        sessionStorage.setItem('passkey_token', result.token);
        window.location.href = '/Account/PasskeyCallback?token=' + encodeURIComponent(result.token);
    } catch (err) {
        if (err.name === 'NotAllowedError') {
            // User cancelled - do nothing
        } else {
            console.error('Passkey error:', err);
            alert('Passkey error: ' + err.message);
        }
    }
}

function base64UrlDecode(str) {
    str = str.replace(/-/g, '+').replace(/_/g, '/');
    while (str.length % 4) str += '=';
    const binary = atob(str);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return bytes.buffer;
}

function base64UrlEncode(buffer) {
    const bytes = new Uint8Array(buffer);
    let str = '';
    for (const b of bytes) str += String.fromCharCode(b);
    return btoa(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
}
</script>
