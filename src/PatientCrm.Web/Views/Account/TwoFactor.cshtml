@{
    ViewData["Title"] = "Two-Factor Authentication";
    Layout = "_LoginLayout";
}

<div style="width: 100%; max-width: 440px;">
    <div style="text-align: center; margin-bottom: 2rem;">
        <div style="width: 64px; height: 64px; background: white; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem; box-shadow: 0 8px 24px rgba(0,0,0,0.15);">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#005EB8" stroke-width="2.5">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
        </div>
        <h1 style="color: white; font-size: 1.75rem; font-weight: 700; margin-bottom: 0.25rem;">PatientCRM</h1>
        <p style="color: rgba(255,255,255,0.7); font-size: 0.875rem;">Two-Factor Authentication</p>
    </div>

    <div style="background: white; border-radius: 16px; padding: 2rem; box-shadow: 0 20px 60px rgba(0,0,0,0.2);">
        <h2 style="font-size: 1.25rem; font-weight: 600; color: #0f172a; margin-bottom: 0.25rem;">Verify your identity</h2>
        <p style="font-size: 0.875rem; color: #64748b; margin-bottom: 1.5rem;">Enter the 6-digit code from your authenticator app or a recovery code.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="margin-bottom: 1rem;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="partialToken" value="@ViewBag.PartialToken" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <input type="hidden" name="rememberMe" value="@ViewBag.RememberMe" />

            <div class="form-group">
                <label class="form-label" for="code">Authenticator Code</label>
                <input type="text" name="code" id="code" class="form-control" required
                       placeholder="123456" autocomplete="one-time-code" maxlength="10"
                       style="font-size: 1.5rem; text-align: center; letter-spacing: 0.5rem;" />
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg" style="margin-top: 1rem;">
                Verify
            </button>
        </form>

        <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid #e2e8f0; font-size: 0.75rem; color: #94a3b8; text-align: center;">
            <p>Can't access your authenticator? Use a recovery code instead.</p>
            <a href="/Account/Login" style="color: #0ea5e9;">Back to login</a>
        </div>
    </div>
</div>
