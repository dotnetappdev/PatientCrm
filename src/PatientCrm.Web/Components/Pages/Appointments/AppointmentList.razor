@page "/appointments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using PatientCrm.Web.Services
@using PatientCrm.Core.Entities
@using PatientCrm.Core.Enums
@inject PatientApiClient Api
@inject NavigationManager Nav

<PageTitle>Appointments - PatientCRM</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Appointments</h1>
        <p class="page-subtitle">@currentDate.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-secondary" @onclick="PreviousDay">← Previous</button>
        <button class="btn btn-secondary" @onclick="GoToToday">Today</button>
        <button class="btn btn-secondary" @onclick="NextDay">Next →</button>
        <a href="/appointments/book" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Book Appointment
        </a>
    </div>
</div>

<div class="table-container">
    <div class="table-header">
        <div class="d-flex gap-2" style="flex-wrap: wrap;">
            <select class="form-control" style="max-width: 180px;" @bind="filterType" @bind:after="ApplyFilters">
                <option value="">All Types</option>
                @foreach (var t in Enum.GetValues<AppointmentType>())
                { <option value="@t">@t</option> }
            </select>
            <select class="form-control" style="max-width: 180px;" @bind="filterStatus" @bind:after="ApplyFilters">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<AppointmentStatus>())
                { <option value="@s">@s</option> }
            </select>
            <span class="text-muted" style="padding: 0.375rem 0; font-size: 0.875rem; align-self: center;">
                @filteredAppointments.Count appointment@(filteredAppointments.Count == 1 ? "" : "s")
            </span>
        </div>
    </div>

    @if (loading)
    {
        <div style="text-align: center; padding: 3rem; color: var(--text-muted);">Loading appointments...</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Patient</th>
                    <th>Reason</th>
                    <th>Clinician</th>
                    <th>Type</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in filteredAppointments)
                {
                    <tr>
                        <td>
                            <div class="fw-600">@appt.StartTime.ToString("HH:mm")</div>
                            <div class="patient-meta">@appt.DurationMinutes min</div>
                        </td>
                        <td>
                            @if (appt.Patient != null)
                            {
                                <div class="patient-info">
                                    <div class="patient-avatar" style="width: 32px; height: 32px; font-size: 0.7rem;">
                                        @(appt.Patient.FirstName.Substring(0,1))@(appt.Patient.LastName.Substring(0,1))
                                    </div>
                                    <div>
                                        <a href="/patients/@appt.Patient.Id" class="patient-name" style="text-decoration: none; color: var(--text-primary);">
                                            @appt.Patient.FullName
                                        </a>
                                    </div>
                                </div>
                            }
                        </td>
                        <td>@(appt.Reason ?? appt.Title)</td>
                        <td>@appt.Provider?.FullName</td>
                        <td><span class="badge badge-blue">@appt.AppointmentType</span></td>
                        <td>
                            <span class="badge @(appt.Status == AppointmentStatus.Completed ? "badge-green" :
                                                  appt.Status == AppointmentStatus.Cancelled ? "badge-red" :
                                                  appt.Status == AppointmentStatus.DidNotAttend ? "badge-amber" : "badge-blue")">
                                @appt.Status
                            </span>
                        </td>
                    </tr>
                }
                @if (!filteredAppointments.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">📅</div>
                            @{
                                var filtersActive = filterType != "" || filterStatus != "";
                                var emptyMessage = filtersActive
                                    ? "No appointments match the current filters."
                                    : $"No appointments scheduled for {currentDate:dd MMMM yyyy}.";
                            }
                            @emptyMessage
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private DateTime currentDate = DateTime.Today;
    private List<Appointment> appointments = [];
    private List<Appointment> filteredAppointments = [];
    private string filterType = "";
    private string filterStatus = "";
    private bool loading = true;

    protected override async Task OnInitializedAsync() => await LoadAppointments();

    private async Task LoadAppointments()
    {
        loading = true;
        appointments = await Api.GetAppointmentsAsync(currentDate) ?? [];
        ApplyFilters();
        loading = false;
    }

    private void ApplyFilters()
    {
        var q = appointments.AsEnumerable();
        if (!string.IsNullOrEmpty(filterType) && Enum.TryParse<AppointmentType>(filterType, out var apptType))
            q = q.Where(a => a.AppointmentType == apptType);
        if (!string.IsNullOrEmpty(filterStatus) && Enum.TryParse<AppointmentStatus>(filterStatus, out var apptStatus))
            q = q.Where(a => a.Status == apptStatus);
        filteredAppointments = q.ToList();
    }

    private async Task PreviousDay() { currentDate = currentDate.AddDays(-1); filterType = ""; filterStatus = ""; await LoadAppointments(); }
    private async Task GoToToday() { currentDate = DateTime.Today; filterType = ""; filterStatus = ""; await LoadAppointments(); }
    private async Task NextDay() { currentDate = currentDate.AddDays(1); filterType = ""; filterStatus = ""; await LoadAppointments(); }
}
