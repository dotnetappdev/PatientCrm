@page "/patients"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using PatientCrm.Web.Services
@using PatientCrm.Core.Entities
@inject PatientApiClient Api
@inject NavigationManager Nav

<PageTitle>Patients - PatientCRM</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Patients</h1>
        <p class="page-subtitle">@total patient records</p>
    </div>
    <a href="/patients/create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Register Patient
    </a>
</div>

<div class="table-container">
    <div class="table-header">
        <div class="d-flex gap-2" style="flex: 1;">
            <div style="position: relative; flex: 1; max-width: 400px;">
                <svg style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" @bind="searchText" @bind:event="oninput" @onkeydown="HandleSearchKey"
                       placeholder="Search by name, NHS/HSCNI number..." class="form-control" style="padding-left: 2.25rem;" />
            </div>
            <button type="button" class="btn btn-secondary" @onclick="DoSearch">Search</button>
        </div>
    </div>

    @if (loading)
    {
        <div style="text-align: center; padding: 3rem; color: var(--text-muted);">Loading patients...</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>NHS / HSCNI No.</th>
                    <th>Date of Birth</th>
                    <th>Contact</th>
                    <th>Region</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in patients)
                {
                    <tr>
                        <td>
                            <div class="patient-info">
                                <div class="patient-avatar">@(patient.FirstName.Substring(0,1))@(patient.LastName.Substring(0,1))</div>
                                <div>
                                    <div class="patient-name">
                                        <a href="/patients/@patient.Id" style="text-decoration: none; color: var(--text-primary);">@patient.FullName</a>
                                    </div>
                                    <div class="patient-meta">@patient.Gender | @patient.BloodGroup</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(patient.NhsNumber))
                            { <span class="nhs-badge">NHS @patient.NhsNumber</span> }
                            else if (!string.IsNullOrEmpty(patient.HscniNumber))
                            { <span class="hscni-badge">HSCNI @patient.HscniNumber</span> }
                            else
                            { <span class="text-muted">-</span> }
                        </td>
                        <td>
                            <div class="fw-600">@patient.DateOfBirth.ToString("dd MMM yyyy")</div>
                            <div class="patient-meta">Age: @CalculateAge(patient.DateOfBirth)</div>
                        </td>
                        <td>
                            <div class="patient-meta">@patient.PhoneNumber</div>
                            <div class="patient-meta">@patient.Email</div>
                        </td>
                        <td><span class="badge badge-blue">@patient.Region</span></td>
                        <td>
                            <span class="badge @(patient.Status == PatientCrm.Core.Enums.PatientStatus.Active ? "badge-green" : "badge-gray")">
                                @patient.Status
                            </span>
                        </td>
                        <td>
                            <a href="/patients/@patient.Id" class="btn btn-sm btn-secondary">View</a>
                        </td>
                    </tr>
                }
                @if (!patients.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🔍</div>
                            No patients found @(string.IsNullOrWhiteSpace(appliedSearch) ? "" : $"for '{appliedSearch}'")
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <div class="table-footer" style="padding: 1rem; display: flex; justify-content: space-between; align-items: center;">
                <span class="text-muted" style="font-size: 0.875rem;">
                    Showing @((currentPage - 1) * pageSize + 1)-@(Math.Min(currentPage * pageSize, total)) of @total
                </span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-secondary" @onclick="PrevPage" disabled="@(currentPage <= 1)">Previous</button>
                    <span style="padding: 0.375rem 0.75rem; font-size: 0.875rem;">Page @currentPage of @totalPages</span>
                    <button class="btn btn-sm btn-secondary" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Next</button>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<Patient> patients = [];
    private string searchText = "";
    private string appliedSearch = "";
    private int currentPage = 1;
    private const int pageSize = 20;
    private int total;
    private int totalPages => (int)Math.Ceiling((double)total / pageSize);
    private bool loading = true;

    protected override async Task OnInitializedAsync() => await LoadPatients();

    private async Task LoadPatients()
    {
        loading = true;
        var result = await Api.GetPatientsAsync(appliedSearch, currentPage, pageSize);
        patients = result?.Patients ?? [];
        total = result?.Total ?? 0;
        loading = false;
    }

    private async Task DoSearch()
    {
        appliedSearch = searchText;
        currentPage = 1;
        await LoadPatients();
    }

    private async Task HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch();
    }

    private async Task PrevPage() { if (currentPage > 1) { currentPage--; await LoadPatients(); } }
    private async Task NextPage() { if (currentPage < totalPages) { currentPage++; await LoadPatients(); } }

    private static int CalculateAge(DateTime dob) =>
        (int)((DateTime.Today - dob).TotalDays / 365.25);
}
