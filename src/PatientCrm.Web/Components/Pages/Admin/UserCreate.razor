@page "/admin/users/create"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,TenantAdmin")]
@using PatientCrm.Web.Services
@using PatientCrm.Core.Entities
@inject PatientApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>Create User - PatientCRM Admin</PageTitle>

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a href="/admin/users" style="color: var(--text-muted); text-decoration: none;">← Users</a>
        <h1 class="page-title">Create User</h1>
    </div>
</div>

<div class="card" style="max-width: 800px;">
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">First Name *</label>
            <input class="form-control" @bind="firstName" />
        </div>
        <div class="form-group">
            <label class="form-label">Last Name *</label>
            <input class="form-control" @bind="lastName" />
        </div>
        <div class="form-group">
            <label class="form-label">Title</label>
            <select class="form-control" @bind="title">
                <option value="">-- None --</option>
                <option value="Dr">Dr</option>
                <option value="Mr">Mr</option>
                <option value="Mrs">Mrs</option>
                <option value="Ms">Ms</option>
                <option value="Miss">Miss</option>
                <option value="Prof">Prof</option>
                <option value="Nurse">Nurse</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group" style="flex: 2;">
            <label class="form-label">Email *</label>
            <input type="email" class="form-control" @bind="email" />
        </div>
        <div class="form-group" style="flex: 2;">
            <label class="form-label">Role *</label>
            <select class="form-control" @bind="role">
                <option value="Receptionist">Receptionist</option>
                <option value="Nurse">Nurse</option>
                <option value="GP">GP</option>
                <option value="Dentist">Dentist</option>
                <option value="Consultant">Consultant</option>
                <option value="TenantAdmin">Tenant Admin</option>
                <option value="SuperAdmin">Super Admin</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Password *</label>
            <input type="password" class="form-control" @bind="password" />
        </div>
        <div class="form-group">
            <label class="form-label">Confirm Password *</label>
            <input type="password" class="form-control" @bind="confirmPassword" />
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label class="form-label">GMC Number</label>
            <input class="form-control" @bind="gmcNumber" placeholder="7654321" />
        </div>
        <div class="form-group">
            <label class="form-label">GDC Number</label>
            <input class="form-control" @bind="gdcNumber" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    { <div class="alert alert-danger">@errorMessage</div> }

    <div class="d-flex gap-2" style="margin-top: 1.5rem;">
        <a href="/admin/users" class="btn btn-secondary">Cancel</a>
        <button class="btn btn-primary" @onclick="Create" disabled="@saving">
            @(saving ? "Creating..." : "Create User")
        </button>
    </div>
</div>

@code {
    private string firstName = "";
    private string lastName = "";
    private string title = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private string role = "GP";
    private string gmcNumber = "";
    private string gdcNumber = "";
    private bool saving;
    private string? errorMessage;

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName) || string.IsNullOrWhiteSpace(email))
        { errorMessage = "First name, last name and email are required."; return; }
        if (string.IsNullOrWhiteSpace(password))
        { errorMessage = "Password is required."; return; }
        if (password != confirmPassword)
        { errorMessage = "Passwords do not match."; return; }

        saving = true;
        errorMessage = null;

        // TenantId will be resolved server-side from the current user's claims
        var ok = await Api.CreateUserAsync(new
        {
            FirstName = firstName,
            LastName = lastName,
            Email = email,
            Password = password,
            Title = title,
            GmcNumber = gmcNumber,
            GdcNumber = gdcNumber,
            TenantId = Guid.Empty, // resolved server-side
            Role = role
        });

        saving = false;
        if (ok)
        {
            Notifications.SetSuccess($"User {firstName} {lastName} created successfully.");
            Nav.NavigateTo("/admin/users");
        }
        else errorMessage = "Failed to create user. The email may already be registered or the password does not meet requirements (min 6 characters, uppercase, number, special character).";
    }
}
