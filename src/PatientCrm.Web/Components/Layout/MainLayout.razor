@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using PatientCrm.Web.Services
@inject NavigationManager Nav
@inject NotificationService Notifications
@inject IHttpContextAccessor HttpContextAccessor
@inject TokenProvider TokenProvider

@* Capture JWT token from claims during the SSR phase (before SignalR) *@
@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Capture the JWT from the cookie claim so PatientApiClient can use it
        if (TokenProvider.AccessToken == null)
        {
            var httpContext = HttpContextAccessor.HttpContext;
            if (httpContext != null)
            {
                TokenProvider.AccessToken = httpContext.User.FindFirst("api_token")?.Value;
            }
            else if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                TokenProvider.AccessToken = auth.User.FindFirst("api_token")?.Value;
            }
        }
    }
}

<div class="app-layout">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
            </div>
            <div class="sidebar-brand-text">
                <h1>PatientCRM</h1>
                <span>NHS &amp; HSCNI Compliant</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <!-- Patient Portal navigation (only visible to patients) -->
            <AuthorizeView Roles="Patient">
                <Authorized>
                    <span class="nav-section-title">My Health Record</span>
                    <NavLink class="nav-item" href="/portal" Match="NavLinkMatch.All" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/>
                        </svg>
                        My Dashboard
                    </NavLink>
                    <NavLink class="nav-item" href="/portal/appointments" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        My Appointments
                    </NavLink>
                    <NavLink class="nav-item" href="/portal/prescriptions" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/><line x1="14.31" y1="8" x2="20.05" y2="17.94"/>
                        </svg>
                        My Medications
                    </NavLink>
                    <NavLink class="nav-item" href="/portal/notes" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/>
                        </svg>
                        My Notes
                    </NavLink>
                    <NavLink class="nav-item" href="/portal/letters" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                        </svg>
                        My Letters
                    </NavLink>
                    <NavLink class="nav-item" href="/portal/profile" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
                        </svg>
                        My Profile
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <!-- Clinician / Admin navigation (hidden from patients) -->
            <AuthorizeView Roles="SuperAdmin,TenantAdmin,GP,Dentist,Consultant,Nurse,Receptionist,ReadOnly">
                <Authorized>
                    <span class="nav-section-title">Overview</span>
                    <NavLink class="nav-item" href="/" Match="NavLinkMatch.All" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/>
                        </svg>
                        Dashboard
                    </NavLink>

                    <span class="nav-section-title">Patients</span>
                    <NavLink class="nav-item" href="/patients" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                        Patients
                    </NavLink>

                    <span class="nav-section-title">Clinical</span>
                    <NavLink class="nav-item" href="/appointments" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        Appointments
                    </NavLink>
                    <NavLink class="nav-item" href="/patients" ActiveClass="">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                        </svg>
                        Clinical Notes
                    </NavLink>
                    <NavLink class="nav-item" href="/patients" ActiveClass="">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/><line x1="14.31" y1="8" x2="20.05" y2="17.94"/>
                        </svg>
                        Prescriptions
                    </NavLink>
                    <NavLink class="nav-item" href="/letters" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                        </svg>
                        Letters
                    </NavLink>

                    <span class="nav-section-title">Admin</span>
                    <NavLink class="nav-item" href="/departments" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                        </svg>
                        Departments
                    </NavLink>
                    <NavLink class="nav-item" href="/admin" Match="NavLinkMatch.All" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>
                        </svg>
                        Dashboard
                    </NavLink>
                    <NavLink class="nav-item" href="/admin/clients" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/>
                        </svg>
                        Clients
                    </NavLink>
                    <NavLink class="nav-item" href="/admin/users" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        </svg>
                        Users
                    </NavLink>
                    <NavLink class="nav-item" href="/admin/settings" ActiveClass="active">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/>
                        </svg>
                        Settings
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <!-- Sidebar Footer -->
        <div style="padding: 1rem 1.25rem; border-top: 1px solid rgba(255,255,255,0.1);">
            <AuthorizeView>
                <Authorized>
                    <a href="/Account/Logout" class="nav-item" style="margin: 0;">
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                        Sign Out
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>

    <!-- Header -->
    <header class="app-header">
        <button class="btn-icon" id="sidebarToggle" aria-label="Toggle sidebar">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>

        <div class="header-search">
            <svg class="header-search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="search" id="globalSearch" placeholder="Search patients by name, NHS number, date of birth..." autocomplete="off" />
        </div>

        <div class="header-actions">
            <button class="theme-toggle" id="themeToggle" onclick="ThemeManager.toggle()" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                Dark Mode
            </button>

            <button class="btn-icon" aria-label="Notifications">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/>
                </svg>
            </button>

            <AuthorizeView>
                <Authorized>
                    <div class="user-avatar" title="@context.User.Identity?.Name">
                        @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <!-- Main content -->
    <main class="app-main" role="main">
        @if (Notifications.SuccessMessage != null)
        {
            <div class="alert alert-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20,6 9,17 4,12"/></svg>
                @Notifications.SuccessMessage
            </div>
        }
        @if (Notifications.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @Notifications.ErrorMessage
            </div>
        }

        @Body
    </main>
</div>
