<?xml version = "1.0" encoding = "UTF-8" ?>
<Application x:Class="PatientCrm.Maui.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:PatientCrm.Maui.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:PositiveIntToBoolConverter x:Key="PositiveIntToBoolConverter" />
            <converters:BoolToActiveConverter x:Key="BoolToActiveConverter" />
            <converters:PatientStatusColorConverter x:Key="PatientStatusColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
