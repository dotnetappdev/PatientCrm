<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PatientCrm.Maui.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PatientCrm.Maui.ViewModels"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F5">

    <ScrollView>
        <VerticalStackLayout Padding="40,60,40,40" Spacing="0">

            <!-- Logo / Branding -->
            <Frame BackgroundColor="#005EB8" CornerRadius="16" Padding="24" Margin="0,0,0,32"
                   HorizontalOptions="Center" WidthRequest="200">
                <VerticalStackLayout Spacing="4">
                    <Label Text="🏥" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="PatientCRM" FontSize="24" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Healthcare Management" FontSize="12"
                           TextColor="#BFD7ED" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Error Message -->
            <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
                   BackgroundColor="#FDECEA" BorderColor="#DA291C" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <Label Text="{Binding ErrorMessage}" TextColor="#DA291C" FontSize="14" />
            </Frame>

            <!-- Login Form -->
            <VerticalStackLayout IsVisible="{Binding ShowTwoFactor, Converter={StaticResource InverseBoolConverter}}" Spacing="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email Address" FontSize="14" FontAttributes="Bold" TextColor="#212B32" />
                    <Entry Text="{Binding Email}" Placeholder="you@example.com"
                           Keyboard="Email" BackgroundColor="White"
                           PlaceholderColor="#768692" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Password" FontSize="14" FontAttributes="Bold" TextColor="#212B32" />
                    <Entry Text="{Binding Password}" Placeholder="Enter your password"
                           IsPassword="True" BackgroundColor="White"
                           PlaceholderColor="#768692" />
                </VerticalStackLayout>

                <Button Text="Sign In" Command="{Binding LoginCommand}"
                        BackgroundColor="#005EB8" TextColor="White"
                        FontAttributes="Bold" FontSize="16"
                        HeightRequest="52" CornerRadius="8"
                        IsEnabled="{Binding IsNotBusy}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#005EB8" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- 2FA Form -->
            <VerticalStackLayout IsVisible="{Binding ShowTwoFactor}" Spacing="16">
                <Label Text="Two-Factor Authentication" FontSize="18" FontAttributes="Bold"
                       TextColor="#212B32" HorizontalOptions="Center" />
                <Label Text="Enter the 6-digit code from your authenticator app."
                       FontSize="14" TextColor="#4C6272" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Entry Text="{Binding TwoFactorCode}" Placeholder="000000"
                       Keyboard="Numeric" MaxLength="6" FontSize="24"
                       HorizontalTextAlignment="Center" BackgroundColor="White" />

                <Button Text="Verify" Command="{Binding VerifyTwoFactorCommand}"
                        BackgroundColor="#005EB8" TextColor="White"
                        FontAttributes="Bold" FontSize="16"
                        HeightRequest="52" CornerRadius="8"
                        IsEnabled="{Binding IsNotBusy}" />
            </VerticalStackLayout>

            <Label Text="PatientCRM © 2024 · NHS-aligned Healthcare Management"
                   FontSize="11" TextColor="#768692" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" Margin="0,32,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
