<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PatientCrm.Maui.Views.DepartmentsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PatientCrm.Maui.ViewModels"
             xmlns:models="clr-namespace:PatientCrm.Maui.Models"
             x:DataType="vm:DepartmentListViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F0F4F5">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
                       BackgroundColor="#FDECEA" BorderColor="#DA291C" CornerRadius="8" Padding="12">
                    <Label Text="{Binding ErrorMessage}" TextColor="#DA291C" />
                </Frame>

                <CollectionView ItemsSource="{Binding Departments}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                            <Label Text="🏥" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="No departments found" FontSize="16" TextColor="#768692" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Department">
                            <Frame BackgroundColor="White" CornerRadius="10" Padding="14" Margin="0,0,0,10" BorderColor="#E8EDEE">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentListViewModel}}, Path=SelectDepartmentCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="#212B32" />
                                        <Label Text="{Binding DepartmentType}" FontSize="12" TextColor="#4C6272" />
                                        <Label Text="{Binding Code, StringFormat='Code: {0}'}" FontSize="11" TextColor="#768692" />
                                        <Label Text="{Binding Location}" FontSize="11" TextColor="#768692" />
                                        <Label Text="{Binding HeadOfDepartment, StringFormat='Head: {0}'}"
                                               FontSize="11" TextColor="#4C6272"
                                               IsVisible="{Binding HeadOfDepartment, Converter={StaticResource NullToBoolConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Wards.Count, StringFormat='{0} wards'}"
                                           FontSize="12" TextColor="#768692" VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Department Detail -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="16"
                       IsVisible="{Binding SelectedDepartment, Converter={StaticResource NullToBoolConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding SelectedDepartment.Name}" FontSize="18" FontAttributes="Bold" TextColor="#212B32" />
                        <Label Text="{Binding SelectedDepartment.Description}" FontSize="13" TextColor="#4C6272" />
                        <Label Text="Wards:" FontSize="14" FontAttributes="Bold" TextColor="#212B32"
                               IsVisible="{Binding SelectedDepartment.Wards.Count, Converter={StaticResource PositiveIntToBoolConverter}}" />
                        <CollectionView ItemsSource="{Binding SelectedDepartment.Wards}" HeightRequest="120">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Ward">
                                    <VerticalStackLayout Padding="0,4" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" TextColor="#212B32" />
                                        <Label Text="{Binding BedCount, StringFormat='{0} beds'}" FontSize="11" TextColor="#768692" />
                                        <BoxView HeightRequest="1" Color="#E8EDEE" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
