<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PatientCrm.Maui.Views.Portal.PortalDashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PatientCrm.Maui.ViewModels.Portal"
             xmlns:models="clr-namespace:PatientCrm.Maui.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:DataType="vm:PortalDashboardViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F0F4F5">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Welcome -->
                <Frame BackgroundColor="#005EB8" CornerRadius="12" Padding="20">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding PatientRecord.FullName, StringFormat='Welcome back, {0}'}"
                               FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat='{0:dddd, d MMMM yyyy}'}"
                               FontSize="13" TextColor="#BFD7ED" />
                        <Label Text="Your health summary" FontSize="13" TextColor="#BFD7ED" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Allergy Alert -->
                <Frame BackgroundColor="#FFF3CD" BorderColor="#FFB81C" CornerRadius="8" Padding="12"
                       IsVisible="{Binding PatientRecord.Allergies, Converter={StaticResource NullToBoolConverter}}">
                    <Label Text="{Binding PatientRecord.Allergies, StringFormat='⚠️ Allergy Alert: {0}'}"
                           TextColor="#856404" FontAttributes="Bold" />
                </Frame>

                <!-- Error -->
                <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
                       BackgroundColor="#FDECEA" BorderColor="#DA291C" CornerRadius="8" Padding="12">
                    <Label Text="{Binding ErrorMessage}" TextColor="#DA291C" />
                </Frame>

                <!-- Quick Stats -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="White" CornerRadius="12" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📅" FontSize="24" />
                            <Label Text="{Binding UpcomingAppointments.Count}" FontSize="24" FontAttributes="Bold" TextColor="#005EB8" />
                            <Label Text="Upcoming" FontSize="11" TextColor="#4C6272" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="White" CornerRadius="12" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💊" FontSize="24" />
                            <Label Text="{Binding ActivePrescriptions.Count}" FontSize="24" FontAttributes="Bold" TextColor="#007F3B" />
                            <Label Text="Medications" FontSize="11" TextColor="#4C6272" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Upcoming Appointments -->
                <Label Text="Upcoming Appointments" FontSize="18" FontAttributes="Bold" TextColor="#212B32" />
                <CollectionView ItemsSource="{Binding UpcomingAppointments}" HeightRequest="200">
                    <CollectionView.EmptyView>
                        <Label Text="No upcoming appointments" TextColor="#768692" HorizontalOptions="Center" FontSize="13" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Appointment">
                            <Frame BackgroundColor="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" TextColor="#212B32" FontSize="14" />
                                    <Label Text="{Binding StartTime, StringFormat='{0:ddd d MMM yyyy HH:mm}'}" FontSize="12" TextColor="#4C6272" />
                                    <Label Text="{Binding DisciplineType}" FontSize="11" TextColor="#768692" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Current Medications -->
                <Label Text="Current Medications" FontSize="18" FontAttributes="Bold" TextColor="#212B32" />
                <CollectionView ItemsSource="{Binding ActivePrescriptions}" HeightRequest="200">
                    <CollectionView.EmptyView>
                        <Label Text="No active medications" TextColor="#768692" HorizontalOptions="Center" FontSize="13" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Prescription">
                            <Frame BackgroundColor="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding MedicationName}" FontAttributes="Bold" TextColor="#212B32" FontSize="14" />
                                        <Label Text="{Binding Dosage}" FontSize="12" TextColor="#4C6272" />
                                        <Label Text="{Binding Frequency}" FontSize="12" TextColor="#768692" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Status}" FontSize="11"
                                           TextColor="#007F3B" VerticalOptions="Center" FontAttributes="Bold" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
