<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PatientCrm.Maui.Views.Portal.PortalLettersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PatientCrm.Maui.ViewModels.Portal"
             xmlns:models="clr-namespace:PatientCrm.Maui.Models"
             x:DataType="vm:PortalLettersViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F0F4F5">

    <Grid RowDefinitions="*,Auto">
        <RefreshView Grid.Row="0" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
                           BackgroundColor="#FDECEA" BorderColor="#DA291C" CornerRadius="8" Padding="12">
                        <Label Text="{Binding ErrorMessage}" TextColor="#DA291C" />
                    </Frame>

                    <CollectionView ItemsSource="{Binding Letters}">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                                <Label Text="📧" FontSize="48" HorizontalOptions="Center" />
                                <Label Text="No letters available" FontSize="16" TextColor="#768692" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Letter">
                                <Frame BackgroundColor="White" CornerRadius="10" Padding="14" Margin="0,0,0,10" BorderColor="#E8EDEE">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PortalLettersViewModel}}, Path=ViewLetterCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Subject}" FontAttributes="Bold" FontSize="14" TextColor="#212B32" />
                                            <Label Text="{Binding AuthorName, StringFormat='From: {0}'}" FontSize="12" TextColor="#4C6272" />
                                            <Label Text="{Binding LetterDate, StringFormat='Date: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="#768692" />
                                        </VerticalStackLayout>
                                        <Frame Grid.Column="1" CornerRadius="6" Padding="6,3" VerticalOptions="Center">
                                            <Frame.BackgroundColor>
                                                <Color>#005EB8</Color>
                                            </Frame.BackgroundColor>
                                            <Label Text="{Binding Status}" FontSize="11" TextColor="White" FontAttributes="Bold" />
                                        </Frame>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Letter Viewer -->
                    <Frame BackgroundColor="White" CornerRadius="12" Padding="20"
                           IsVisible="{Binding SelectedLetter, Converter={StaticResource NullToBoolConverter}}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding SelectedLetter.Subject}"
                                       FontSize="18" FontAttributes="Bold" TextColor="#212B32" />
                                <Button Grid.Column="1" Text="✕" Command="{Binding CloseLetterViewerCommand}"
                                        BackgroundColor="Transparent" TextColor="#768692" FontSize="18" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E8EDEE" />
                            <Label Text="{Binding SelectedLetter.PracticeName}" FontSize="14" TextColor="#4C6272" />
                            <Label Text="{Binding SelectedLetter.AuthorName, StringFormat='From: {0}'}"
                                   FontSize="13" TextColor="#4C6272" />
                            <Label Text="{Binding SelectedLetter.LetterDate, StringFormat='Date: {0:dd/MM/yyyy}'}"
                                   FontSize="12" TextColor="#768692" />
                            <BoxView HeightRequest="1" Color="#E8EDEE" />
                            <Label Text="{Binding SelectedLetter.Body}" FontSize="14" TextColor="#212B32" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
