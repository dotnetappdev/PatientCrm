<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PatientCrm.Maui.Views.Portal.PortalNotesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PatientCrm.Maui.ViewModels.Portal"
             xmlns:models="clr-namespace:PatientCrm.Maui.Models"
             x:DataType="vm:PortalNotesViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F0F4F5">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <!-- Disclosure -->
                <Frame BackgroundColor="#E3F2FD" BorderColor="#005EB8" CornerRadius="8" Padding="12">
                    <Label Text="ℹ️ Some notes may be kept private by your clinical team. Only non-confidential notes are shown here."
                           FontSize="13" TextColor="#003087" />
                </Frame>

                <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
                       BackgroundColor="#FDECEA" BorderColor="#DA291C" CornerRadius="8" Padding="12">
                    <Label Text="{Binding ErrorMessage}" TextColor="#DA291C" />
                </Frame>

                <CollectionView ItemsSource="{Binding Notes}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                            <Label Text="📋" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="No clinical notes available" FontSize="16" TextColor="#768692" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ClinicalNote">
                            <Frame BackgroundColor="White" CornerRadius="10" Padding="14" Margin="0,0,0,10" BorderColor="#E8EDEE">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#212B32" />
                                    <Label Text="{Binding NoteDate, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="#4C6272" />
                                    <Label Text="{Binding AuthorName, StringFormat='By {0}'}" FontSize="12" TextColor="#4C6272" />
                                    <Label Text="{Binding DisciplineType}" FontSize="11" TextColor="#768692" />
                                    <BoxView HeightRequest="1" Color="#E8EDEE" />
                                    <Label Text="{Binding Assessment, StringFormat='Assessment: {0}'}"
                                           FontSize="13" TextColor="#212B32"
                                           IsVisible="{Binding Assessment, Converter={StaticResource NullToBoolConverter}}" />
                                    <Label Text="{Binding Plan, StringFormat='Plan: {0}'}"
                                           FontSize="13" TextColor="#212B32"
                                           IsVisible="{Binding Plan, Converter={StaticResource NullToBoolConverter}}" />
                                    <Label Text="{Binding FollowUpDate, StringFormat='Follow-up: {0:dd/MM/yyyy}'}"
                                           FontSize="12" TextColor="#005EB8" FontAttributes="Bold"
                                           IsVisible="{Binding RequiresFollowUp}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
