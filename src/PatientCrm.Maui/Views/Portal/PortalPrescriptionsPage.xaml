<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PatientCrm.Maui.Views.Portal.PortalPrescriptionsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PatientCrm.Maui.ViewModels.Portal"
             xmlns:models="clr-namespace:PatientCrm.Maui.Models"
             x:DataType="vm:PortalPrescriptionsViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F0F4F5">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
                       BackgroundColor="#FDECEA" BorderColor="#DA291C" CornerRadius="8" Padding="12">
                    <Label Text="{Binding ErrorMessage}" TextColor="#DA291C" />
                </Frame>
                <Frame IsVisible="{Binding SuccessMessage, Converter={StaticResource NullToBoolConverter}}"
                       BackgroundColor="#E8F5E9" BorderColor="#007F3B" CornerRadius="8" Padding="12">
                    <Label Text="{Binding SuccessMessage}" TextColor="#007F3B" />
                </Frame>

                <CollectionView ItemsSource="{Binding Prescriptions}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                            <Label Text="💊" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="No medications on record" FontSize="16" TextColor="#768692" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Prescription">
                            <Frame BackgroundColor="White" CornerRadius="10" Padding="14" Margin="0,0,0,10" BorderColor="#E8EDEE">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding MedicationName}"
                                               FontAttributes="Bold" FontSize="16" TextColor="#212B32" />
                                        <Frame Grid.Column="1" CornerRadius="6" Padding="6,3"
                                               BackgroundColor="#007F3B">
                                            <Label Text="{Binding Status}" FontSize="11" TextColor="White" FontAttributes="Bold" />
                                        </Frame>
                                    </Grid>
                                    <Label Text="{Binding Dosage, StringFormat='Dose: {0}'}" FontSize="13" TextColor="#4C6272" />
                                    <Label Text="{Binding Frequency, StringFormat='Frequency: {0}'}" FontSize="13" TextColor="#4C6272" />
                                    <Label Text="{Binding Route, StringFormat='Route: {0}'}" FontSize="12" TextColor="#768692" />
                                    <Label Text="{Binding RepeatsRemaining, StringFormat='Repeats remaining: {0}'}"
                                           FontSize="12" TextColor="#768692" />
                                    <Label Text="{Binding Instructions}" FontSize="12" TextColor="#4C6272"
                                           IsVisible="{Binding Instructions, Converter={StaticResource NullToBoolConverter}}" />
                                    <Label Text="⚠️ Controlled Drug" FontSize="12" TextColor="#DA291C" FontAttributes="Bold"
                                           IsVisible="{Binding IsControlledDrug}" />
                                    <Button Text="Request Repeat"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PortalPrescriptionsViewModel}}, Path=RequestRepeatCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#005EB8" TextColor="White"
                                            CornerRadius="8" HeightRequest="36" FontSize="12"
                                            IsVisible="{Binding RepeatsRemaining, Converter={StaticResource PositiveIntToBoolConverter}}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
