<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PatientCrm.Maui.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PatientCrm.Maui.ViewModels"
             xmlns:models="clr-namespace:PatientCrm.Maui.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F0F4F5">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Header -->
                <Label Text="Clinical Dashboard" FontSize="22" FontAttributes="Bold"
                       TextColor="#212B32" Margin="0,8,0,0" />
                <Label Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat='{0:dddd, d MMMM yyyy}'}"
                       FontSize="14" TextColor="#4C6272" />

                <!-- Error Banner -->
                <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
                       BackgroundColor="#FDECEA" BorderColor="#DA291C" CornerRadius="8" Padding="12">
                    <Label Text="{Binding ErrorMessage}" TextColor="#DA291C" />
                </Frame>

                <!-- Stats Grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <!-- Total Patients -->
                    <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="White" CornerRadius="12" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👥" FontSize="28" />
                            <Label Text="{Binding Stats.TotalPatients}" FontSize="28" FontAttributes="Bold" TextColor="#005EB8" />
                            <Label Text="Total Patients" FontSize="12" TextColor="#4C6272" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Today's Appointments -->
                    <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="White" CornerRadius="12" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📅" FontSize="28" />
                            <Label Text="{Binding Stats.TodayAppointments}" FontSize="28" FontAttributes="Bold" TextColor="#007F3B" />
                            <Label Text="Today's Appointments" FontSize="12" TextColor="#4C6272" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Active Prescriptions -->
                    <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="White" CornerRadius="12" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💊" FontSize="28" />
                            <Label Text="{Binding Stats.ActivePrescriptions}" FontSize="28" FontAttributes="Bold" TextColor="#FFB81C" />
                            <Label Text="Active Prescriptions" FontSize="12" TextColor="#4C6272" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Active Alerts -->
                    <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="White" CornerRadius="12" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="⚠️" FontSize="28" />
                            <Label Text="{Binding Stats.ActiveAlerts}" FontSize="28" FontAttributes="Bold" TextColor="#DA291C" />
                            <Label Text="Active Alerts" FontSize="12" TextColor="#4C6272" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Recent Patients -->
                <Label Text="Recent Patients" FontSize="18" FontAttributes="Bold" TextColor="#212B32" />
                <CollectionView ItemsSource="{Binding Stats.RecentPatients}" HeightRequest="200">
                    <CollectionView.EmptyView>
                        <Label Text="No recent patients" TextColor="#768692" HorizontalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Patient">
                            <Frame BackgroundColor="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Frame BackgroundColor="#005EB8" CornerRadius="20" WidthRequest="40" HeightRequest="40" Padding="0">
                                        <Label Text="{Binding FirstName[0]}" TextColor="White" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding FullName}" FontAttributes="Bold" TextColor="#212B32" />
                                        <Label Text="{Binding NhsNumber, StringFormat='NHS: {0}'}" FontSize="12" TextColor="#4C6272" />
                                    </VerticalStackLayout>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Upcoming Appointments -->
                <Label Text="Upcoming Appointments" FontSize="18" FontAttributes="Bold" TextColor="#212B32" />
                <CollectionView ItemsSource="{Binding Stats.UpcomingAppointments}" HeightRequest="200">
                    <CollectionView.EmptyView>
                        <Label Text="No upcoming appointments" TextColor="#768692" HorizontalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Appointment">
                            <Frame BackgroundColor="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" TextColor="#212B32" />
                                    <Label Text="{Binding PatientName}" FontSize="12" TextColor="#4C6272" />
                                    <Label Text="{Binding StartTime, StringFormat='{0:ddd d MMM yyyy HH:mm}'}"
                                           FontSize="12" TextColor="#768692" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
